<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Futures Trading Journal</title>
<style>
:root{
  --bg:#0b1020;--panel:#121a2d;--panel2:#18223a;--text:#eef3ff;--muted:#98a6c7;
  --green:#2ecc71;--red:#ff5c67;--blue:#5ba7ff;--yellow:#f6c453;--line:#273452;
}
*{box-sizing:border-box} body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:linear-gradient(135deg,#080c18,#111a30);color:var(--text)}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
.sidebar{background:#0b1222;border-right:1px solid var(--line);padding:24px 18px;position:sticky;top:0;height:100vh}
.brand{font-size:21px;font-weight:800;margin-bottom:18px}.brand span{color:var(--blue)}
.journal-switcher{margin-bottom:18px}
.journal-switcher label{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}
.journal-switcher select{width:100%;background:var(--panel);border:1px solid var(--line);color:white;padding:9px;border-radius:9px}
.journal-switcher .journal-actions{display:flex;gap:6px;margin-top:7px}
.journal-switcher .journal-actions button{flex:1;padding:7px 8px;font-size:12px}
.nav button{width:100%;text-align:left;border:0;background:transparent;color:var(--muted);padding:12px 14px;border-radius:10px;margin:4px 0}
.nav button.active,.nav button:hover{background:var(--panel2);color:white}
.main{padding:26px;min-width:0}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}
h1{font-size:28px;margin:0}.sub{color:var(--muted);margin-top:5px}
.btn{border:0;border-radius:10px;padding:10px 14px;background:var(--panel2);color:white}
.btn.primary{background:var(--blue);color:#06101f;font-weight:800}.btn.danger{background:var(--red);color:#220408}
.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(5,minmax(140px,1fr))}
.card{background:rgba(18,26,45,.94);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 12px 30px rgba(0,0,0,.18)}
.metric .label{color:var(--muted);font-size:13px}.metric .value{font-size:27px;font-weight:800;margin-top:6px}
.pos{color:var(--green)}.neg{color:var(--red)}
.charts{grid-template-columns:1fr 1.7fr;margin-top:16px}.chart-wrap{height:320px;position:relative}
canvas{width:100%;height:100%}
.section{display:none}.section.active{display:block}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:15px}.toolbar input,.toolbar select{background:var(--panel);border:1px solid var(--line);color:white;padding:10px;border-radius:10px}
.trade-list{display:grid;gap:14px}.trade{display:grid;grid-template-columns:1.2fr .8fr 1fr auto;gap:16px;align-items:center}
.trade .title{font-size:18px;font-weight:800}.trade .meta{color:var(--muted);font-size:13px;margin-top:5px}.pill{display:inline-block;padding:5px 9px;border-radius:999px;font-weight:800;font-size:12px}
.pill.win{background:rgba(46,204,113,.15);color:var(--green)}.pill.loss{background:rgba(255,92,103,.15);color:var(--red)}
.thumbs{display:flex;gap:7px}.thumbs img{width:64px;height:48px;object-fit:cover;border-radius:7px;border:1px solid var(--line)}
.comment{color:#cfd8ee;font-size:14px;line-height:1.45}
.actions{display:flex;gap:7px}.icon{padding:8px 10px;border:1px solid var(--line);background:transparent;color:white;border-radius:8px}
.calendar-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.dow{text-align:center;color:var(--muted);font-size:12px;padding:6px}
.day{min-height:105px;background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:9px;position:relative}
.day.empty{opacity:.25}.day .num{font-weight:800}.day .pnl{font-size:12px;margin-top:7px}.day .count{font-size:11px;color:var(--muted);margin-top:4px}
.day.has{cursor:pointer}.day.limit{box-shadow:inset 0 0 0 2px var(--red)}
.limitbox{display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:end}.field label{display:block;color:var(--muted);font-size:13px;margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;background:#0d1527;border:1px solid var(--line);color:white;border-radius:10px;padding:10px}
textarea{min-height:100px;resize:vertical}.formgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}.full{grid-column:1/-1}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:20px;z-index:20}
.modal.open{display:flex}.modalbox{width:min(900px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px}
.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.image-preview{display:flex;gap:10px;flex-wrap:wrap}.image-preview img{width:120px;height:90px;object-fit:cover;border-radius:9px;border:1px solid var(--line)}
.alert{padding:11px 13px;border-radius:10px;margin-bottom:14px;display:none}.alert.show{display:block}.alert.red{background:rgba(255,92,103,.15);color:#ff9da5}.alert.green{background:rgba(46,204,113,.15);color:#86e8ad}
.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:900px}th,td{text-align:left;padding:11px;border-bottom:1px solid var(--line);font-size:13px}th{color:var(--muted)}
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}

.portfolio-panel{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}
.portfolio-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;border:0;background:transparent;color:var(--text);font-weight:800;padding:8px 4px}
.portfolio-body{display:grid;gap:8px;padding:8px 4px 0}.portfolio-body.collapsed{display:none}
.portfolio-row{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:12px}.portfolio-row strong{color:var(--text)}
.status-toast{position:fixed;right:22px;bottom:22px;z-index:50;padding:12px 16px;border-radius:10px;background:#18223a;border:1px solid var(--line);box-shadow:0 10px 30px rgba(0,0,0,.35);display:none}.status-toast.show{display:block}
@media(max-width:1000px){#integrations>.grid{grid-template-columns:1fr!important}.journal-switcher{min-width:220px;margin:0 12px}.stats{grid-template-columns:repeat(2,1fr)}.charts{grid-template-columns:1fr}.trade{grid-template-columns:1fr}.app{grid-template-columns:1fr}.sidebar{height:auto;position:static;display:flex;align-items:center;justify-content:space-between;padding:14px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap}.brand{margin:0}.main{padding:16px}}
@media(max-width:600px){.formgrid,.settings-grid,.limitbox{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.calendar{gap:4px}.day{min-height:78px;padding:6px}.day .pnl{font-size:10px}}
@media print{.sidebar,.topbar .btn,.toolbar,.actions{display:none!important}.app{display:block}.main{padding:0}.section{display:block!important;page-break-after:always}.modal{display:none!important}}

.hero-banner{height:240px;border-radius:18px;overflow:hidden;position:relative;margin-bottom:16px;border:1px solid var(--line);box-shadow:0 16px 40px rgba(0,0,0,.35)}
.hero-banner img{width:100%;height:100%;object-fit:cover;display:block}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,8,18,.82),rgba(4,8,18,.18),rgba(4,8,18,.72));display:flex;flex-direction:column;justify-content:center;align-items:center;text-shadow:0 3px 14px #000}
.hero-title{font-size:42px;font-weight:900;letter-spacing:2px}.hero-title span{color:#f6a623}.hero-sub{margin-top:8px;color:#d8e2f7;font-size:16px;letter-spacing:1px}
.login-overlay{position:fixed;inset:0;z-index:2147483647;background:radial-gradient(circle at 50% 10%,#17233d,#070b14 60%);display:flex;align-items:center;justify-content:center;padding:20px}
.login-overlay.hidden{display:none}
.login-card{width:min(430px,100%);position:relative;z-index:2;pointer-events:auto;background:rgba(15,22,38,.97);border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:0 30px 80px rgba(0,0,0,.55);text-align:center}
.login-card img{width:120px;height:120px;border-radius:24px;object-fit:cover;border:2px solid #f6a623;margin-bottom:14px}
.login-card h1{font-size:26px}.login-card input{width:100%;margin-top:12px;position:relative;z-index:3;pointer-events:auto;user-select:text;-webkit-user-select:text;cursor:text;background:#0d1527;border:1px solid var(--line);color:white;border-radius:10px;padding:12px}
.login-error{color:#ff8e98;min-height:22px;margin-top:8px;font-size:13px}
@media(max-width:700px){.hero-banner{height:180px}.hero-title{font-size:28px}}


@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
body{font-family:Inter,Segoe UI,Arial,sans-serif}
.card{transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
.card:hover{transform:translateY(-1px);border-color:#34507d;box-shadow:0 16px 38px rgba(0,0,0,.24)}
.hero-banner:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 40%,rgba(91,167,255,.12),transparent 42%),linear-gradient(90deg,rgba(18,33,57,.28),transparent 48%,rgba(246,166,35,.12));pointer-events:none}
.hero-title{filter:drop-shadow(0 0 16px rgba(91,167,255,.18))}
.hero-title span{filter:drop-shadow(0 0 14px rgba(246,166,35,.32))}


/* Kompaktní širokoúhlý banner – dashboard je vidět bez rolování */
.dashboard-banner{width:100%;height:150px;position:relative;overflow:hidden;border:1px solid var(--line);border-radius:14px;margin-bottom:14px;background:#080d18;box-shadow:0 10px 26px rgba(0,0,0,.22)}
.dashboard-banner img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 48%}
.dashboard-banner::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,9,18,.18),rgba(4,9,18,.02),rgba(4,9,18,.18));pointer-events:none}
@media(max-width:1000px){#integrations>.grid{grid-template-columns:1fr!important}.dashboard-banner{height:110px}}
@media(max-width:600px){.dashboard-banner{height:78px;border-radius:10px}}


/* Dashboard 3.0.4: jedna obrazovka bez spodní řady metrik */
#dashboard .charts{margin-top:14px}
#dashboard .chart-wrap{height:300px}
#dashboard .card{padding:16px}
.main{padding-top:18px;padding-bottom:18px}
.topbar{margin-bottom:16px}
@media(max-height:900px) and (min-width:1001px){
  .dashboard-banner{height:128px}
  #dashboard .chart-wrap{height:270px}
  .main{padding-top:14px;padding-bottom:14px}
  .topbar{margin-bottom:12px}
}


.account-filter-card{margin-bottom:16px}.account-filter-title{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.account-filter-grid{display:grid;grid-template-columns:repeat(7,minmax(120px,1fr));gap:10px;margin-top:14px;align-items:end}
.optional-badge{font-size:11px;font-weight:700;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 7px;vertical-align:middle}
.money-dual{display:inline-flex;flex-direction:column;line-height:1.15}.money-dual .main-money{font-weight:inherit}.money-dual .secondary-money{font-size:10px;color:var(--muted);font-weight:600;margin-top:3px}.move-trade-info{margin-bottom:12px;color:var(--muted);font-size:13px}
.trade-plan-editor{margin-top:10px}.trade-plan-details{margin-top:10px;border-top:1px solid var(--line);padding-top:8px}
.trade-plan-details summary{cursor:pointer;color:var(--blue);font-weight:700}.trade-plan-content{margin-top:8px;color:#cfd8ee;font-size:13px;line-height:1.55}
@media(max-width:1150px){.account-filter-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:700px){.home-cards,.account-filter-grid{grid-template-columns:1fr}}


.home-image-only{
  position:relative;
  width:100%;
  height:calc(100vh - 52px);
  min-height:640px;
  overflow:hidden;
  background:#050914;
}
.home-image-only img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:center center;
  image-rendering:auto;
  filter:contrast(1.06) saturate(1.1) brightness(.98);
}
@media(max-width:900px){
  .home-image-only{height:calc(100vh - 44px);min-height:520px}
}


.integration-top{grid-template-columns:1.2fr .8fr}
.integration-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.mapping-row{display:grid;grid-template-columns:1fr 1.2fr;gap:8px;align-items:center;margin-top:8px}
.open-position{padding:9px 0;border-bottom:1px solid var(--line)}
.open-position:last-child{border-bottom:0}
@media(max-width:1000px){.integration-top{grid-template-columns:1fr}.mapping-row{grid-template-columns:1fr}}

@media(max-width:850px){}


.portfolio-detail-toolbar{display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:12px;align-items:end;margin:14px 0 18px}
.instrument-portfolio-detail{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(380px,1.1fr);gap:18px;align-items:stretch;margin-top:16px}
.instrument-portfolio-chart{height:520px;background:rgba(11,18,34,.55);border:1px solid var(--line);border-radius:14px;padding:16px}
#instrumentPortfolioPie{width:100%;height:100%}
.instrument-portfolio-list{display:flex;flex-direction:column;gap:9px;max-height:520px;overflow:auto;padding-right:8px}
.instrument-portfolio-row{display:grid;grid-template-columns:14px 1fr auto auto;gap:10px;align-items:center;border:1px solid var(--line);border-radius:11px;padding:11px 12px;background:rgba(11,18,34,.55)}
.instrument-portfolio-row strong{font-size:14px}
.instrument-portfolio-row .share{color:var(--muted);min-width:60px;text-align:right}
.instrument-portfolio-row .pnl{min-width:110px;text-align:right;font-weight:800}
.instrument-dot{width:12px;height:12px;border-radius:50%}
@media(max-width:850px){.portfolio-detail-toolbar{grid-template-columns:1fr}.instrument-portfolio-detail{grid-template-columns:1fr}.instrument-portfolio-chart{height:300px}.instrument-portfolio-list{max-height:none}}


.instrument-section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.fixed-section-card{min-height:540px}

</style>
</head>
<body>
</div>


<div class="login-overlay" id="loginOverlay">
  <div class="login-card">
    <img src="assets/bull_bear_icon.png" alt="Futures Journal PRO">
    <h1>Futures Journal PRO</h1>
    <div class="sub" id="loginHint">Přihlášení do obchodního deníku</div>
    <input type="password" id="loginPassword" placeholder="Zadej heslo" autocomplete="current-password" autofocus tabindex="1">
    <input type="password" id="loginPassword2" placeholder="Zopakuj heslo" autocomplete="new-password" style="display:none" tabindex="2">
    <div class="login-error" id="loginError"></div>
    <button class="btn primary" id="loginButton" type="button" tabindex="3" style="width:100%;position:relative;z-index:3;pointer-events:auto">Přihlásit se</button>
  </div>
</div>

<div class="app">
  <aside class="sidebar">
    <div class="brand">Futures <span>Journal</span></div>
    <div class="journal-switcher">
      <label>Aktivní deník</label>
      <select id="journalSelect"></select>
      <div class="journal-actions">
        <button class="btn" id="newJournalBtn">＋ Nový</button>
        <button class="btn" id="renameJournalBtn">✏️ Přejmenovat</button>
        <button class="btn danger" id="deleteJournalBtn">🗑️</button>
      </div>
    </div>
    <div class="nav">
      <button class="active" data-section="home">🏠 Úvod</button>
      <button data-section="openPositions">📈 Otevřené pozice</button>
      <button data-section="accountOverview">📊 Přehled účtu</button>
      <button data-section="instrumentPortfolio">🥧 Podíl instrumentů</button>
      <button data-section="journal">📒 Deník</button>
      <button data-section="calendar">📅 Kalendář</button>
      <button data-section="reports">📑 Reporty</button>
      <button data-section="integrations">🔌 Integrace</button>
      <button data-section="settings">⚙️ Nastavení</button>
    </div>
  </aside>

  <main class="main">
<div class="topbar">
      <div><h1 id="pageTitle">Dashboard</h1><div class="sub">Obchodní deník pro futures</div></div>
      <button class="btn primary" id="addTradeBtn">＋ Přidat obchod</button>
    </div>

    
    
    <section id="home" class="section active">
      <div class="home-image-only">
        <img src="assets/bull_bear_home_4k.jpg" alt="Býk a medvěd – Futures Journal PRO">
      </div>
    </section>


    <section id="openPositions" class="section">
      <div class="card">
        <div class="instrument-section-head">
          <div>
            <h2>Otevřené pozice</h2>
            <p class="sub">Aktuálně otevřené pozice zachycené z NinjaTraderu.</p>
          </div>
          <button class="btn danger" id="clearInvalidPositions">Vymazat neplatné pozice</button>
        </div>
        <div class="table-scroll" style="margin-top:16px">
          <table>
            <thead><tr><th>Instrument</th><th>Pozice</th><th>Čas vstupu</th><th>Cena vstupu</th><th>Aktuální cena</th><th>Zisk / ztráta</th></tr></thead>
            <tbody id="captureOpenPositions"><tr><td colspan="6" class="sub">Žádné otevřené pozice.</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="accountOverview" class="section">

      <div class="card account-filter-card">
        <div class="account-filter-title">
          <div><h2>Přehled účtu</h2><p class="sub">Vyber přesně, která data chceš zobrazit.</p></div>
          <button class="btn" id="clearAccountFilters">Vymazat filtry</button>
        </div>
        <div class="account-filter-grid">
          <div class="field"><label>Rozsah</label><select id="accountRangeMode">
            <option value="all">Kompletní portfolio</option>
            <option value="day">Jeden den</option>
            <option value="interval">Interval datumů</option>
          </select></div>
          <div class="field account-day-field"><label>Datum</label><input type="date" id="accountDay"></div>
          <div class="field account-interval-field"><label>Od</label><input type="date" id="accountFrom"></div>
          <div class="field account-interval-field"><label>Do</label><input type="date" id="accountTo"></div>
          <div class="field"><label>Deník / karta</label><select id="accountJournal"><option value="">Všechny deníky</option></select></div>
          <div class="field"><label>Instrument</label><select id="accountInstrument"><option value="">Všechny instrumenty</option></select></div>
          <div class="field"><label>&nbsp;</label><button class="btn primary" id="applyAccountFilters">Zobrazit</button></div>
        </div>
      </div>

      <div id="limitAlert" class="alert red"></div>
      <div class="grid stats">
        <div class="card metric"><div class="label">Stav účtu</div><div class="value" id="accountValue">0 Kč</div></div>
        <div class="card metric"><div class="label">Celkové P/L</div><div class="value" id="totalPnl">0</div></div>
        <div class="card metric"><div class="label">Úspěšné obchody</div><div class="value pos" id="wins">0</div></div>
        <div class="card metric"><div class="label">Ztrátové obchody</div><div class="value neg" id="losses">0</div></div>
        <div class="card metric"><div class="label">Win rate</div><div class="value" id="winrate">0 %</div></div>
</div>
      <div class="grid charts">
        <div class="card"><h3>Poměr Target / Stop Loss</h3><div class="chart-wrap"><canvas id="pieChart"></canvas></div></div>
        <div class="card"><h3>Equity křivka</h3><div class="chart-wrap"><canvas id="equityChart"></canvas></div></div>
      </div>
      <div class="card" style="margin-top:16px">
        <h3>Vybrané obchody</h3>
        <div id="accountOverviewTrades" class="trade-list"></div>
      </div>

    </section>

    
    <section id="instrumentPortfolio" class="section">
      <div class="card">
        <div class="instrument-section-head">
          <div>
            <h2>Podíl instrumentů v portfoliu</h2>
            <p class="sub">Procentní rozdělení, počet obchodů a zisk nebo ztráta podle instrumentů.</p>
          </div>
        </div>

        <div class="portfolio-detail-toolbar">
          <div class="field">
            <label>Deník / karta</label>
            <select id="instrumentPortfolioJournal">
              <option value="">Všechny deníky</option>
            </select>
          </div>
          <div class="field">
            <label>Datum od</label>
            <input type="date" id="instrumentPortfolioFrom">
          </div>
          <div class="field">
            <label>Datum do</label>
            <input type="date" id="instrumentPortfolioTo">
          </div>
          <div class="field">
            <label>&nbsp;</label>
            <button class="btn primary" id="refreshInstrumentPortfolio" type="button">Aktualizovat</button>
          </div>
        </div>
      </div>

      <div class="instrument-portfolio-detail fixed-section-card">
        <div class="card instrument-portfolio-chart">
          <canvas id="instrumentPortfolioPie"></canvas>
        </div>
        <div class="card instrument-portfolio-list" id="instrumentPortfolioList"></div>
      </div>
    </section>

    <section id="journal" class="section">
      <div class="toolbar">
        <input id="search" placeholder="Hledat instrument nebo komentář">
        <select id="filterResult"><option value="">Všechny výsledky</option><option value="target">Target</option><option value="stoploss">Stop Loss</option></select>
        <input type="date" id="filterDate">
        <button class="btn" id="exportCsv">Export CSV</button>
        <button class="btn" id="printPdf">Tisk / PDF</button>
      </div>
      <div id="tradeList" class="trade-list"></div>
    </section>

    <section id="calendar" class="section">
      <div class="card">
        <div class="calendar-head">
          <button class="btn" id="prevMonth">◀</button>
          <h2 id="monthLabel"></h2>
          <button class="btn" id="nextMonth">▶</button>
        </div>
        <div class="calendar" id="calendarGrid"></div>
      </div>
      <div class="card" style="margin-top:16px">
        <h3>Obchody vybraného dne</h3>
        <div id="dayTrades" class="trade-list"><div class="sub">Klikni v kalendáři na den s obchody.</div></div>
      </div>
    </section>

    
    <section id="reports" class="section">
      <div class="card">
        <h2>Reporty obchodování</h2>
        <div class="toolbar">
          <div class="field"><label>Od</label><input type="date" id="reportFrom"></div>
          <div class="field"><label>Do</label><input type="date" id="reportTo"></div>
          <div class="field"><label>Deník / karta</label><select id="reportJournal"><option value="">Všechny deníky</option></select></div>
          <div class="field"><label>Instrument</label><select id="reportInstrument"><option value="">Všechny instrumenty</option></select></div>
          <button class="btn primary" id="generateReport">Vytvořit report</button>
          <button class="btn" id="reportCsv">Export CSV</button>
          <button class="btn" id="reportPrint">Tisk / PDF</button>
        </div>
      </div>
      <div class="grid stats" style="margin-top:16px">
        <div class="card metric"><div class="label">Počet obchodů</div><div class="value" id="reportCount">0</div></div>
        <div class="card metric"><div class="label">Celkové P/L</div><div class="value" id="reportPnl">0</div></div>
        <div class="card metric"><div class="label">Win rate</div><div class="value" id="reportWinrate">0 %</div></div>
        <div class="card metric"><div class="label">Profit Factor</div><div class="value" id="reportPf">0</div></div>
        <div class="card metric"><div class="label">Průměr / obchod</div><div class="value" id="reportAvg">0</div></div>
      </div>
      <div class="grid charts" style="margin-top:16px">
        <div class="card"><h3>Vývoj P/L v čase</h3><div class="chart-wrap"><canvas id="reportChart"></canvas></div></div>
        <div class="card"><h3>Souhrn podle instrumentů</h3><div class="table-scroll"><table><thead><tr><th>Instrument</th><th>Obchody</th><th>Výhry</th><th>Prohry</th><th>Win rate</th><th>P/L</th></tr></thead><tbody id="reportInstrumentRows"></tbody></table></div></div>
      </div>
      <div class="card" style="margin-top:16px">
        <h3>Souhrn podle deníků / karet</h3>
        <div class="table-scroll"><table><thead><tr><th>Deník</th><th>Obchody</th><th>Výhry</th><th>Prohry</th><th>Win rate</th><th>P/L</th></tr></thead><tbody id="reportJournalRows"></tbody></table></div>
      </div>
      <div class="card" style="margin-top:16px">
        <h3>Jednotlivé obchody ve výběru</h3>
        <div id="reportTradeList" class="trade-list"></div>
      </div>
    </section>

    
    
    <section id="integrations" class="section">
      <div class="grid integration-top">
        <div class="card">
          <h2>NinjaTrader – automatické obchody</h2>
          <p class="sub">Exekuce se automaticky párují do otevřených a uzavřených obchodů, včetně částečných fillů a otočení pozice.</p>
          <div class="settings-grid" style="margin-top:16px">
            <div class="field"><label>Stav služby</label><input id="captureStatusText" readonly></div>
            <div class="field"><label>Uzavřené obchody čekající na import</label><input id="capturePendingCount" readonly></div>
            <div class="field full"><label>Lokální endpoint</label><input id="captureEndpoint" readonly></div>
            <div class="field full"><label>API klíč pro NinjaTrader</label><input id="captureApiKey" readonly></div>
            <div class="field"><label>Automatické screenshoty</label>
              <select id="captureScreenshotMode">
                <option value="none">Vypnuto</option>
                <option value="primary">Hlavní monitor</option>
                <option value="all">Všechny monitory</option>
              </select>
            </div>
            <div class="field"><label>Automatický import</label>
              <select id="captureAutoImportSelect"><option value="ano">Zapnuto</option><option value="ne">Vypnuto</option></select>
            </div>
          </div>
          <div class="integration-actions">
            <button class="btn primary" id="captureRefresh">Obnovit stav</button>
            <button class="btn" id="captureTestSequence">Otestovat vstup a výstup</button>
            <button class="btn" id="captureImport">Importovat nyní</button>
            <button class="btn primary" id="captureInstallNinja">Nainstalovat NinjaTrader konektor automaticky</button>
            <button class="btn" id="captureExportConnector">Pouze stáhnout NinjaTrader konektor</button>
            <button class="btn primary" id="capturePrepareTradingView">Připravit Pine Script a otevřít TradingView</button>
            <button class="btn primary" id="capturePrepareWorker">Připravit webhook a otevřít Cloudflare</button>
            <button class="btn" id="captureExportTradingView">Pouze stáhnout TradingView Pine Script</button>
            <button class="btn" id="captureExportTradingViewWorker">Pouze stáhnout TradingView webhook relay</button>
            <button class="btn" id="captureOpenConnectors">Otevřít složku konektorů</button>
            <button class="btn" id="captureNewKey">Nový API klíč</button>
            <button class="btn danger" id="captureClear">Vymazat frontu</button>
          </div>
        </div>
        <div class="card">
          <h3>Přiřazení účtů ke kartám</h3>
          <p class="sub">Například SIM101 → Simulace, APEX-123 → Apex účet.</p>
          <div id="captureMappingRows"></div>
          <button class="btn" id="captureSaveMappings" style="margin-top:12px">Uložit přiřazení</button>
          <div id="captureHiddenAccountsBox" style="margin-top:16px"></div>
        </div>
      </div>

      <div class="card" style="margin-top:16px">
        <h2>TradingView – webhook relay</h2>
        <p class="sub">TradingView nemůže posílat na localhost. Připravený Cloudflare Worker přijme veřejný webhook a aplikace si alerty bezpečně stáhne.</p>
        <div class="settings-grid" style="margin-top:14px">
          <div class="field full"><label>Veřejná adresa Workeru</label><input id="relayUrl" placeholder="https://futures-journal-relay...workers.dev"></div>
          <div class="field"><label>Relay token</label><input id="relayToken" placeholder="tajný token"></div>
          <div class="field"><label>Stav</label><select id="relayEnabled"><option value="ne">Vypnuto</option><option value="ano">Zapnuto</option></select></div>
        </div>
        <div class="integration-actions">
          <button class="btn primary" id="saveRelay">Uložit relay</button>
          <button class="btn" id="pollRelay">Stáhnout alerty nyní</button>
        </div>
        <p class="sub" style="margin-top:10px">Zdroj Workeru a Pine Script jsou ve složce <b>CONNECTORS</b>.</p>
      </div>

    </section>

    <section id="settings" class="section">
      <div class="settings-grid">
        <div class="card">
          <h3>Zabezpečení aplikace</h3>
          <p class="sub">Při prvním spuštění si nastavíš vlastní heslo.</p>
          <button class="btn" id="changePassword">Změnit heslo</button>
          <button class="btn" id="lockApp" style="margin-left:8px">🔒 Zamknout aplikaci</button>
        </div>
        <div class="card">
          <h3>Účet a denní limity</h3>
          <div class="field"><label>Počáteční stav účtu</label><input type="number" id="startingBalance" step="0.01"></div>
          <div class="field" style="margin-top:12px"><label>Hlavní měna</label><input id="currency" value="USD" disabled></div>
          <div class="field" style="margin-top:12px"><label>Kurz USD/CZK</label><input id="usdCzkRate" type="number" min="0.01" step="0.01" value="23.00"><div class="sub">Částky zadávej v USD. Pod nimi se automaticky zobrazí orientační přepočet v CZK.</div></div>
          <div class="field" style="margin-top:12px"><label>Denní limit ztráty v měně účtu</label><input type="number" id="dailyLossLimit" step="0.01"></div>
          <div class="field" style="margin-top:12px"><label>Denní limit ztráty v bodech</label><input type="number" id="dailyPointLimit" step="0.01"></div>
          <button class="btn primary" id="saveSettings" style="margin-top:14px">Uložit nastavení</button>
        </div>
        <div class="card">
          <h3>Záloha a obnova</h3>
          <p class="sub">Data se ukládají lokálně v tomto prohlížeči.</p>
          <button class="btn primary" id="updateBackup">💾 Aktualizovat zálohu na SSD</button>
          <button class="btn" id="restoreBackup" style="display:block;margin-top:10px">♻️ Obnovit ze zálohy</button>
          <div id="backupPathInfo" class="sub" style="margin-top:10px">Umístění zálohy zatím není zvoleno.</div>
          <hr style="border:0;border-top:1px solid var(--line);margin:18px 0">
          <button class="btn" id="exportJson">Stáhnout zálohu JSON</button>
          <label class="btn" style="display:inline-block;margin-top:10px">Nahrát zálohu<input id="importJson" type="file" accept=".json" hidden></label>
          <button class="btn danger" id="clearAll" style="display:block;margin-top:18px">Smazat data aktuálního deníku</button>
          <button class="btn danger" id="factoryReset" style="display:block;margin-top:10px">⚠️ Kompletní reset aplikace</button>
          <div class="sub" style="margin-top:8px">Smaže všechny deníky, obchody, nastavení i uloženou cestu k záloze.</div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="status-toast" id="statusToast"></div>

<div class="modal" id="journalNameModal">
  <div class="modalbox" style="max-width:520px">
    <div class="modalhead"><h2 id="journalNameModalTitle">Nový deník</h2><button class="icon" id="closeJournalNameModal">✕</button></div>
    <div class="field"><label id="journalNameLabel">Název deníku</label><input id="journalNameInput" maxlength="60" placeholder="Např. NQ, ES nebo GC"></div>
    <div id="journalNameError" class="alert red"></div>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px">
      <button class="btn" id="cancelJournalName">Zrušit</button>
      <button class="btn primary" id="saveJournalName">Uložit</button>
    </div>
  </div>
</div>
<div class="modal" id="moveTradeModal">
  <div class="modalbox" style="max-width:520px">
    <div class="modalhead"><h2>Přesunout obchod</h2><button class="icon" id="closeMoveTradeModal">✕</button></div>
    <div id="moveTradeInfo" class="move-trade-info"></div>
    <div class="field"><label>Cílový deník</label><select id="moveTradeTargetJournal"></select></div>
    <div id="moveTradeError" class="alert red"></div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px"><button class="btn" id="cancelMoveTrade">Zrušit</button><button class="btn primary" id="confirmMoveTrade">Přesunout obchod</button></div>
  </div>
</div>

<div class="modal" id="tradeModal">
  <div class="modalbox">
    <div class="modalhead"><h2 id="modalTitle">Nový obchod</h2><button class="icon" id="closeModal">✕</button></div>
    <form id="tradeForm" novalidate>
      <div class="sub" style="margin-bottom:12px">Všechna pole jsou nepovinná. Obchod lze uložit i bez vyplnění údajů.</div>
      <input type="hidden" id="tradeId">
      <div class="formgrid">
        <div class="field"><label>Instrument</label><input id="instrument" placeholder="např. NQ, ES, CL"></div>
        <div class="field"><label>Datum</label><input id="date" type="date"></div>
        <div class="field"><label>Čas vstupu</label><input id="entryTime" type="time"></div>
        <div class="field"><label>Cena vstupu</label><input id="entryPrice" type="number" step="any"></div>
        <div class="field"><label>Čas výstupu</label><input id="exitTime" type="time"></div>
        <div class="field"><label>Cena výstupu</label><input id="exitPrice" type="number" step="any"></div>
        <div class="field"><label>Výsledek</label><select id="result"><option value="target">Target (+)</option><option value="stoploss">Stop Loss (−)</option></select></div>
        <div class="field"><label>Počet bodů</label><input id="points" type="number" step="any"></div>
        <div class="field"><label>Zisk / ztráta v měně účtu</label><input id="pnl" type="number" step="any"></div>
        <div class="field"><label>Počet kontraktů</label><input id="contracts" type="number" step="1" value="1"></div>
        <div class="field"><label>Strategie</label><input id="strategy" placeholder="Volitelné"></div>
        <div class="field"><label>Dodržen obchodní plán?</label><select id="planFollowed"><option value="ano">Ano</option><option value="ne">Ne</option></select></div>
        
        <div class="field full">
          <label>Obchodní plán k tomuto obchodu <span class="optional-badge">nepovinné</span></label>
          <div class="formgrid trade-plan-editor">
            <div class="field"><label>Instrument plánu</label><input id="tradePlanInstrument" placeholder="např. NQ"></div>
            <div class="field"><label>Maximální počet obchodů</label><input id="tradePlanMaxTrades" type="number" step="1"></div>
            <div class="field"><label>Limit ztráty</label><input id="tradePlanLossLimit" type="number" step="any"></div>
            <div class="field"><label>Denní cíl</label><input id="tradePlanProfitTarget" type="number" step="any"></div>
            <div class="field"><label>Obchodovat od</label><input id="tradePlanFromTime" type="time"></div>
            <div class="field"><label>Obchodovat do</label><input id="tradePlanToTime" type="time"></div>
            <div class="field full"><label>Setup / scénář</label><textarea id="tradePlanSetup" placeholder="Volitelné"></textarea></div>
            <div class="field full"><label>Psychologický checklist</label><textarea id="tradePlanPsychology" placeholder="Volitelné"></textarea></div>
            <div class="field full"><label>Poznámka k plánu</label><textarea id="tradePlanNote" placeholder="Volitelné"></textarea></div>
          </div>
        </div>

        <div class="field full"><label>Komentář <span class="optional-badge">nepovinné</span></label><textarea id="comment" placeholder="Volitelné"></textarea></div>
        <div class="field full"><label>Screenshots – maximálně 3 obrázky</label><input id="screenshots" type="file" accept="image/*" multiple><div class="image-preview" id="imagePreview"></div></div>
      </div>
      <div id="formAlert" class="alert red"></div>
      <button class="btn primary" type="submit" style="margin-top:16px">Uložit obchod</button>
    </form>
  </div>
</div>

<script>
const DB_VERSION=1;
const JOURNAL_LIST_KEY='FuturesJournal_profiles';
const ACTIVE_JOURNAL_KEY='FuturesJournal_active';
let journalProfiles=JSON.parse(localStorage.getItem(JOURNAL_LIST_KEY)||'[]');
// Přednastavený „Hlavní deník“ se v aplikaci nepoužívá. Zobrazují se pouze deníky vytvořené uživatelem.
journalProfiles=journalProfiles.filter(j=>!(j?.id==='default'||String(j?.name||'').trim().toLowerCase()==='hlavní deník'));
localStorage.setItem(JOURNAL_LIST_KEY,JSON.stringify(journalProfiles));
let activeJournalId=localStorage.getItem(ACTIVE_JOURNAL_KEY)||journalProfiles[0]?.id||'';
if(!journalProfiles.some(j=>j.id===activeJournalId)) activeJournalId=journalProfiles[0]?.id||'';
if(activeJournalId)localStorage.setItem(ACTIVE_JOURNAL_KEY,activeJournalId);else localStorage.removeItem(ACTIVE_JOURNAL_KEY);

async function removeLegacyDefaultJournal(){
 // Odstraní pouze technický soubor starého přednastaveného profilu. Uživatelské deníky ani jejich data nemaže.
 try{await window.desktopAPI?.deleteJournal?.('default')}catch(e){console.warn('Starý přednastavený deník se nepodařilo odstranit:',e)}
}
function currentDBName(){return 'FuturesJournalDB_'+activeJournalId}
let db={data:{trades:[],settings:[]},close(){}}, trades=[], settings={startingBalance:100000,currency:'USD',usdCzkRate:23,dailyLossLimit:5000,dailyPointLimit:100};
let editImages=[], calendarDate=new Date();

async function openDB(){
 if(!window.desktopAPI?.readJournal)throw new Error('Datové úložiště desktopové aplikace není dostupné.');
 const result=await window.desktopAPI.readJournal(activeJournalId);
 if(!result?.ok)throw new Error(result?.error||'Data deníku nelze načíst.');
 db={data:result.data||{trades:[],settings:[]},close(){}};if(!Array.isArray(db.data.trades))db.data.trades=[];if(!Array.isArray(db.data.settings))db.data.settings=[];
}
async function ensureActiveJournalData(){
 if(db?.data){
  if(!Array.isArray(db.data.trades))db.data.trades=[];
  if(!Array.isArray(db.data.settings))db.data.settings=[];
  return db.data;
 }
 if(!window.desktopAPI?.readJournal)throw new Error('Datové úložiště desktopové aplikace není dostupné.');
 const result=await window.desktopAPI.readJournal(activeJournalId);
 if(!result?.ok)throw new Error(result?.error||'Aktivní deník nelze načíst.');
 const data=result.data||{trades:[],settings:[]};
 if(!Array.isArray(data.trades))data.trades=[];
 if(!Array.isArray(data.settings))data.settings=[];
 db={data,close(){}};
 return db.data;
}
async function persistDB(){
 const data=await ensureActiveJournalData();
 const result=await window.desktopAPI.writeJournal(activeJournalId,data);
 if(!result?.ok)throw new Error(result?.error||'Data deníku nelze uložit.');
}
async function getAll(name){
 const data=await ensureActiveJournalData();
 return structuredClone(data[name]||[]);
}
async function put(name,val){
 const data=await ensureActiveJournalData();
 const rows=data[name]||(data[name]=[]);
 const key=name==='trades'?'id':'key';
 const idx=rows.findIndex(x=>x?.[key]===val?.[key]);
 if(idx>=0)rows[idx]=structuredClone(val);else rows.push(structuredClone(val));
 await persistDB();
}
async function del(name,keyValue){
 const data=await ensureActiveJournalData();
 data[name]=(data[name]||[]).filter(x=>x?.id!==keyValue&&x?.key!==keyValue);
 await persistDB();
}
async function clearStore(name){
 const data=await ensureActiveJournalData();
 data[name]=[];
 await persistDB();
}

const $=id=>document.getElementById(id);
function money(n){return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(Number(n)||0)}
function moneyCzk(n){return new Intl.NumberFormat('cs-CZ',{style:'currency',currency:'CZK',maximumFractionDigits:2}).format((Number(n)||0)*(Number(settings.usdCzkRate)||23))}
function dualMoney(n,withSign=false){const v=Number(n)||0,sign=withSign&&v>0?'+':'';return `<span class="money-dual"><span class="main-money">${sign}${money(v)}</span><span class="secondary-money">${sign}${moneyCzk(v)}</span></span>`}
function dualMoneyText(n,withSign=false){const v=Number(n)||0,sign=withSign&&v>0?'+':'';return `${sign}${money(v)} (${sign}${moneyCzk(v)})`}
function signed(t,field='pnl'){const v=Number(t[field]||0);return t.result==='target'?v:-v}
function esc(s=''){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function sentenceCount(s){return (s.match(/[.!?]+(?=\s|$)/g)||[]).length}

async function load(){
 trades=await getAll('trades');
 const saved=await getAll('settings');
 if(saved.length) settings={...settings,...saved[0].value};
 fillSettings(); renderAll();
}
function fillSettings(){
 $('startingBalance').value=settings.startingBalance;$('currency').value='USD';$('usdCzkRate').value=settings.usdCzkRate||23;
 $('dailyLossLimit').value=settings.dailyLossLimit;$('dailyPointLimit').value=settings.dailyPointLimit;
}
function renderAll(){renderDashboard();renderTrades();renderCalendar();refreshInstrumentPortfolioCard()}

let instrumentPortfolioRows=[];

async function collectInstrumentPortfolioRows(){
 const rows=[];
 for(const p of journalProfiles){
  try{
   const r=await window.desktopAPI.readJournal(p.id);
   if(!r?.ok)continue;
   const ts=Array.isArray(r.data?.trades)?r.data.trades:[];
   rows.push(...ts.map(t=>({...t,journalId:p.id,journalName:p.name})));
  }catch{}
 }
 return rows;
}
function instrumentPortfolioFilteredRows(){
 const journal=$('instrumentPortfolioJournal')?.value||'';
 const from=$('instrumentPortfolioFrom')?.value||'';
 const to=$('instrumentPortfolioTo')?.value||'';
 return instrumentPortfolioRows.filter(t=>{
  if(journal&&t.journalId!==journal)return false;
  if(from&&t.date&&t.date<from)return false;
  if(to&&t.date&&t.date>to)return false;
  return true;
 });
}
function groupInstrumentPortfolio(rows){
 const grouped={};
 rows.forEach(t=>{
  const key=(t.instrument||'Nezadáno').trim()||'Nezadáno';
  if(!grouped[key])grouped[key]={instrument:key,count:0,weight:0,pnl:0,wins:0,losses:0};
  grouped[key].count++;
  grouped[key].pnl+=signed(t);
  grouped[key].weight+=Math.abs(signed(t));
  if(t.result==='target')grouped[key].wins++;
  if(t.result==='stoploss')grouped[key].losses++;
 });
 let list=Object.values(grouped);
 let totalWeight=list.reduce((a,x)=>a+x.weight,0);
 if(totalWeight===0){list.forEach(x=>x.weight=x.count);totalWeight=list.reduce((a,x)=>a+x.weight,0)}
 list.sort((a,b)=>b.weight-a.weight);
 return {list,totalWeight};
}
function drawInstrumentPortfolio(){
 const canvas=$('instrumentPortfolioPie');
 if(!canvas)return;
 const {list,totalWeight}=groupInstrumentPortfolio(instrumentPortfolioFilteredRows());
 const palette=['#5ba7ff','#f6c453','#2ecc71','#ff5c67','#9b7bff','#42d6c8','#ff9d5c','#7bc96f','#d96cff','#7f8ea8','#4ecdc4','#ff6b9d'];
 const {x,w,h}=setupCanvas(canvas);x.clearRect(0,0,w,h);
 const listBox=$('instrumentPortfolioList');
 if(!list.length||!totalWeight){
  x.fillStyle='#98a6c7';x.textAlign='center';x.font='15px sans-serif';x.fillText('Pro vybraný filtr nejsou data',w/2,h/2);
  listBox.innerHTML='<div class="sub">Žádné instrumenty.</div>';return;
 }
 const cx=w/2,cy=h/2,r=Math.min(w,h)*.36;let start=-Math.PI/2;
 list.forEach((item,index)=>{
  const end=start+(item.weight/totalWeight)*Math.PI*2;
  x.beginPath();x.moveTo(cx,cy);x.arc(cx,cy,r,start,end);x.closePath();x.fillStyle=palette[index%palette.length];x.fill();start=end;
 });
 x.beginPath();x.arc(cx,cy,r*.57,0,Math.PI*2);x.fillStyle='#121a2d';x.fill();
 x.textAlign='center';x.fillStyle='white';x.font='800 22px sans-serif';x.fillText(`${list.length}`,cx,cy-2);
 x.fillStyle='#98a6c7';x.font='13px sans-serif';x.fillText('instrumentů',cx,cy+20);
 listBox.innerHTML=list.map((item,index)=>{
  const share=(item.weight/totalWeight)*100;
  return `<div class="instrument-portfolio-row">
    <span class="instrument-dot" style="background:${palette[index%palette.length]}"></span>
    <div><strong>${esc(item.instrument)}</strong><div class="sub">${item.count} obchodů · ${item.wins} ziskových · ${item.losses} ztrátových</div></div>
    <span class="share">${share.toFixed(1)} %</span>
    <span class="pnl ${item.pnl>=0?'pos':'neg'}">${dualMoney(item.pnl,true)}</span>
  </div>`;
 }).join('');
}
async function refreshInstrumentPortfolioCard(){return}
async function initInstrumentPortfolioSection(){
 instrumentPortfolioRows=await collectInstrumentPortfolioRows();
 const select=$('instrumentPortfolioJournal');
 const current=select.value;
 select.innerHTML='<option value="">Všechny deníky</option>'+journalProfiles.map(j=>`<option value="${esc(j.id)}">${esc(j.name)}</option>`).join('');
 select.value=current;
 drawInstrumentPortfolio();
}
function renderDashboard(rows=trades){
 const safeRows=Array.isArray(rows)?rows:[];
 const wins=safeRows.filter(t=>t.result==='target'), losses=safeRows.filter(t=>t.result==='stoploss');
 const total=safeRows.reduce((a,t)=>a+signed(t),0), balance=Number(settings.startingBalance)+total;
 if($('accountValue'))$('accountValue').innerHTML=dualMoney(balance);
 if($('totalPnl')){$('totalPnl').innerHTML=dualMoney(total,true);$('totalPnl').className='value '+(total>=0?'pos':'neg')}
 if($('wins'))$('wins').textContent=wins.length;
 if($('losses'))$('losses').textContent=losses.length;
 if($('winrate'))$('winrate').textContent=safeRows.length?((wins.length/safeRows.length)*100).toFixed(1)+' %':'0 %';
 if($('pieChart'))drawPie(wins.length,losses.length);
 if($('equityChart'))drawEquityRows(safeRows);
 const today=new Date().toISOString().slice(0,10),dt=safeRows.filter(t=>t.date===today);
 const lossMoney=dt.filter(t=>t.result==='stoploss').reduce((a,t)=>a+Number(t.pnl),0);
 const lossPoints=dt.filter(t=>t.result==='stoploss').reduce((a,t)=>a+Number(t.points),0);
 const breaches=[];
 if(settings.dailyLossLimit&&lossMoney>=settings.dailyLossLimit)breaches.push(`měnový limit ${dualMoneyText(settings.dailyLossLimit)}`);
 if(settings.dailyPointLimit&&lossPoints>=settings.dailyPointLimit)breaches.push(`bodový limit ${settings.dailyPointLimit} bodů`);
 const a=$('limitAlert');if(a){if(breaches.length){a.textContent='⚠️ Dosažen '+breaches.join(' a ')+'.';a.classList.add('show')}else a.classList.remove('show')}
}
function setupCanvas(c){
 const dpr=devicePixelRatio||1,rect=c.getBoundingClientRect();c.width=rect.width*dpr;c.height=rect.height*dpr;
 const x=c.getContext('2d');x.scale(dpr,dpr);return {x,w:rect.width,h:rect.height};
}
function drawPie(wins,losses){
 const {x,w,h}=setupCanvas($('pieChart')),cx=w/2,cy=h/2,r=Math.min(w,h)*.32,total=wins+losses;
 x.clearRect(0,0,w,h);
 if(!total){x.fillStyle='#98a6c7';x.textAlign='center';x.font='16px sans-serif';x.fillText('Zatím žádné obchody',cx,cy);return}
 let start=-Math.PI/2;
 [[wins,'#2ecc71','Target'],[losses,'#ff5c67','Stop Loss']].forEach(([v,c])=>{
  const end=start+(v/total)*Math.PI*2;x.beginPath();x.moveTo(cx,cy);x.arc(cx,cy,r,start,end);x.closePath();x.fillStyle=c;x.fill();start=end;
 });
 x.beginPath();x.arc(cx,cy,r*.56,0,Math.PI*2);x.fillStyle='#121a2d';x.fill();
 x.fillStyle='white';x.textAlign='center';x.font='700 26px sans-serif';x.fillText(total,cx,cy+7);
 x.font='13px sans-serif';x.fillStyle='#98a6c7';x.fillText('obchodů',cx,cy+28);
 x.textAlign='left';x.fillStyle='#2ecc71';x.fillRect(18,h-44,12,12);x.fillStyle='white';x.fillText(`Target ${wins}`,38,h-33);
 x.fillStyle='#ff5c67';x.fillRect(w-120,h-44,12,12);x.fillStyle='white';x.fillText(`SL ${losses}`,w-100,h-33);
}
function drawEquityRows(rows){
 const {x,w,h}=setupCanvas($('equityChart')),pad={l:65,r:20,t:25,b:45};
 const daily={};rows.forEach(t=>{if(t.date)daily[t.date]=(daily[t.date]||0)+signed(t)});
 const dates=Object.keys(daily).sort(),vals=[Number(settings.startingBalance)];
 dates.forEach(d=>vals.push(vals.at(-1)+daily[d]));
 const labels=['Start',...dates];let min=Math.min(...vals),max=Math.max(...vals);if(min===max){min-=1;max+=1}
 x.clearRect(0,0,w,h);x.strokeStyle='#273452';x.fillStyle='#98a6c7';x.font='11px sans-serif';
 for(let i=0;i<5;i++){const y=pad.t+(h-pad.t-pad.b)*i/4;x.beginPath();x.moveTo(pad.l,y);x.lineTo(w-pad.r,y);x.stroke();x.fillText(Math.round(max-(max-min)*i/4),6,y+4)}
 if(vals.length<2){x.fillText('Equity se zobrazí po prvním obchodu',pad.l+20,h/2);return}
 const px=i=>pad.l+(w-pad.l-pad.r)*i/(vals.length-1),py=v=>pad.t+(max-v)/(max-min)*(h-pad.t-pad.b);
 x.beginPath();vals.forEach((v,i)=>i?x.lineTo(px(i),py(v)):x.moveTo(px(i),py(v)));x.strokeStyle='#5ba7ff';x.lineWidth=3;x.stroke();
 x.fillStyle='#5ba7ff';vals.forEach((v,i)=>{x.beginPath();x.arc(px(i),py(v),3,0,Math.PI*2);x.fill()});
 const step=Math.max(1,Math.ceil(labels.length/6));x.fillStyle='#98a6c7';x.textAlign='center';
 labels.forEach((l,i)=>{if(i%step===0||i===labels.length-1)x.fillText(l==='Start'?l:l.slice(5),px(i),h-18)});
}
function drawEquity(){
 const {x,w,h}=setupCanvas($('equityChart')),pad={l:65,r:20,t:25,b:45};
 const daily={};trades.forEach(t=>daily[t.date]=(daily[t.date]||0)+signed(t));
 const dates=Object.keys(daily).sort(), vals=[Number(settings.startingBalance)];
 dates.forEach(d=>vals.push(vals.at(-1)+daily[d]));
 const labels=['Start',...dates];let min=Math.min(...vals),max=Math.max(...vals);if(min===max){min-=1;max+=1}
 x.clearRect(0,0,w,h);x.strokeStyle='#273452';x.fillStyle='#98a6c7';x.font='11px sans-serif';
 for(let i=0;i<5;i++){const y=pad.t+(h-pad.t-pad.b)*i/4;x.beginPath();x.moveTo(pad.l,y);x.lineTo(w-pad.r,y);x.stroke();const v=max-(max-min)*i/4;x.fillText(Math.round(v),6,y+4)}
 if(vals.length<2){x.fillText('Equity se zobrazí po prvním obchodu',pad.l+20,h/2);return}
 const px=i=>pad.l+(w-pad.l-pad.r)*i/(vals.length-1),py=v=>pad.t+(max-v)/(max-min)*(h-pad.t-pad.b);
 x.beginPath();vals.forEach((v,i)=>i?x.lineTo(px(i),py(v)):x.moveTo(px(i),py(v)));x.strokeStyle='#5ba7ff';x.lineWidth=3;x.stroke();
 x.fillStyle='#5ba7ff';vals.forEach((v,i)=>{x.beginPath();x.arc(px(i),py(v),3,0,Math.PI*2);x.fill()});
 const step=Math.max(1,Math.ceil(labels.length/6));x.fillStyle='#98a6c7';x.textAlign='center';
 labels.forEach((l,i)=>{if(i%step===0||i===labels.length-1)x.fillText(l==='Start'?l:l.slice(5),px(i),h-18)});
}
function tradeHTML(t){
 const s=t.result==='target'?'+':'−',cls=t.result==='target'?'win':'loss';
 return `<div class="card trade">
 <div><div class="title">${esc(t.instrument)} <span class="pill ${cls}">${t.result==='target'?'TARGET':'STOP LOSS'}</span></div>
 <div class="meta">${t.date} · ${t.entryTime} @ ${t.entryPrice} → ${t.exitTime} @ ${t.exitPrice}</div>
 <div style="margin-top:8px;font-weight:800" class="${t.result==='target'?'pos':'neg'}">${s}${t.points} bodů · ${dualMoney(t.result==='target'?Number(t.pnl||0):-Number(t.pnl||0),false)}</div></div>
 <div><div class="meta">Kontrakty: ${t.contracts}</div><div class="meta">Strategie: ${esc(t.strategy||'—')}</div><div class="meta">Plán: ${t.planFollowed==='ano'?'dodržen':'nedodržen'}</div></div>
 <div><div class="comment">${esc(t.comment)}</div>
 ${t.dailyPlan?`<details class="trade-plan-details"><summary>Obchodní plán</summary><div class="trade-plan-content">
 ${t.dailyPlan.instrument?`<div><b>Instrument:</b> ${esc(t.dailyPlan.instrument)}</div>`:''}
 ${t.dailyPlan.maxTrades?`<div><b>Max. obchodů:</b> ${esc(t.dailyPlan.maxTrades)}</div>`:''}
 ${t.dailyPlan.lossLimit?`<div><b>Limit ztráty:</b> ${esc(t.dailyPlan.lossLimit)}</div>`:''}
 ${t.dailyPlan.profitTarget?`<div><b>Denní cíl:</b> ${esc(t.dailyPlan.profitTarget)}</div>`:''}
 ${t.dailyPlan.fromTime||t.dailyPlan.toTime?`<div><b>Čas:</b> ${esc(t.dailyPlan.fromTime||'—')}–${esc(t.dailyPlan.toTime||'—')}</div>`:''}
 ${t.dailyPlan.setup?`<div><b>Setup:</b> ${esc(t.dailyPlan.setup)}</div>`:''}
 ${t.dailyPlan.psychology?`<div><b>Psychologie:</b> ${esc(t.dailyPlan.psychology)}</div>`:''}
 ${t.dailyPlan.note?`<div><b>Poznámka:</b> ${esc(t.dailyPlan.note)}</div>`:''}
 </div></details>`:''}
 <div class="thumbs">${(t.images||[]).map(i=>`<img src="${i}" onclick="openImage('${i}')">`).join('')}</div></div>
 <div class="actions"><button class="icon" title="Přesunout obchod" onclick="openMoveTrade('${t.id}','${t.journalId||activeJournalId}')">↪️</button><button class="icon" onclick="editTrade('${t.id}')">✏️</button><button class="icon" onclick="deleteTrade('${t.id}')">🗑️</button></div></div>`
}

function renderTrades(){
 const q=$('search').value.toLowerCase(),r=$('filterResult').value,d=$('filterDate').value;
 const list=trades.filter(t=>(!q||(t.instrument+' '+t.comment+' '+(t.strategy||'')).toLowerCase().includes(q))&&(!r||t.result===r)&&(!d||t.date===d)).sort((a,b)=>(b.date+b.entryTime).localeCompare(a.date+a.entryTime));
 $('tradeList').innerHTML=list.length?list.map(tradeHTML).join(''):'<div class="card sub">Zatím zde nejsou žádné obchody.</div>';
}
function renderCalendar(){
 const y=calendarDate.getFullYear(),m=calendarDate.getMonth();
 $('monthLabel').textContent=new Intl.DateTimeFormat('cs-CZ',{month:'long',year:'numeric'}).format(calendarDate);
 const names=['Po','Út','St','Čt','Pá','So','Ne'];let html=names.map(n=>`<div class="dow">${n}</div>`).join('');
 const first=(new Date(y,m,1).getDay()+6)%7,days=new Date(y,m+1,0).getDate();
 for(let i=0;i<first;i++)html+='<div class="day empty"></div>';
 for(let day=1;day<=days;day++){
  const date=`${y}-${String(m+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`,ts=trades.filter(t=>t.date===date),p=ts.reduce((a,t)=>a+signed(t),0);
  const lp=ts.filter(t=>t.result==='stoploss').reduce((a,t)=>a+Number(t.points),0),lm=ts.filter(t=>t.result==='stoploss').reduce((a,t)=>a+Number(t.pnl),0);
  const limit=(settings.dailyLossLimit&&lm>=settings.dailyLossLimit)||(settings.dailyPointLimit&&lp>=settings.dailyPointLimit);
  html+=`<div class="day ${ts.length?'has':''} ${limit?'limit':''}" ${ts.length?`onclick="showDay('${date}')"`:''}><div class="num">${day}</div>${ts.length?`<div class="pnl ${p>=0?'pos':'neg'}">${dualMoney(p,true)}</div><div class="count">${ts.length} obchodů</div>`:''}</div>`;
 }
 $('calendarGrid').innerHTML=html;
}
window.showDay=date=>{$('dayTrades').innerHTML=trades.filter(t=>t.date===date).sort((a,b)=>a.entryTime.localeCompare(b.entryTime)).map(tradeHTML).join('')};
window.openImage=src=>{const w=window.open();w.document.write(`<img src="${src}" style="max-width:100%">`)};

function openModal(t=null){
 $('tradeForm').reset();editImages=[];$('imagePreview').innerHTML='';$('tradeId').value=t?.id||'';
 $('modalTitle').textContent=t?'Upravit obchod':'Nový obchod';
 if(t){['instrument','date','entryTime','entryPrice','exitTime','exitPrice','result','points','pnl','contracts','strategy','planFollowed','comment'].forEach(k=>$(k).value=t[k]??'');
 const p=t.dailyPlan||{};
 $('tradePlanInstrument').value=p.instrument||'';
 $('tradePlanMaxTrades').value=p.maxTrades||'';
 $('tradePlanLossLimit').value=p.lossLimit||'';
 $('tradePlanProfitTarget').value=p.profitTarget||'';
 $('tradePlanFromTime').value=p.fromTime||'';
 $('tradePlanToTime').value=p.toTime||'';
 $('tradePlanSetup').value=p.setup||'';
 $('tradePlanPsychology').value=p.psychology||'';
 $('tradePlanNote').value=p.note||'';
 editImages=t.images||[];showPreviews()}
 else{$('date').value=new Date().toISOString().slice(0,10);$('contracts').value=1;
 ['tradePlanInstrument','tradePlanMaxTrades','tradePlanLossLimit','tradePlanProfitTarget','tradePlanFromTime','tradePlanToTime','tradePlanSetup','tradePlanPsychology','tradePlanNote'].forEach(id=>$(id).value='')}
 if($('formAlert')){$('formAlert').classList.remove('show');$('formAlert').textContent=''};$('tradeModal').classList.add('open')
}
function showPreviews(){$('imagePreview').innerHTML=editImages.map((src,i)=>`<div><img src="${src}"><button type="button" class="icon" onclick="removeImg(${i})">✕</button></div>`).join('')}
window.removeImg=i=>{editImages.splice(i,1);showPreviews()}
window.editTrade=id=>openModal(trades.find(t=>t.id===id));
window.deleteTrade=async id=>{if(confirm('Opravdu smazat tento obchod?')){await del('trades',id);await load()}};

$('screenshots').addEventListener('change',async e=>{
 const files=[...e.target.files].slice(0,3-editImages.length);
 for(const f of files){if(f.size>3_000_000){alert('Jeden obrázek je větší než 3 MB. Zvol menší soubor.');continue}
  const data=await new Promise(res=>{const r=new FileReader();r.onload=()=>res(r.result);r.readAsDataURL(f)});editImages.push(data)}
 showPreviews();e.target.value='';
});
$('tradeForm').addEventListener('submit',async e=>{
 e.preventDefault();
 const a=$('formAlert');
 a.classList.remove('show');a.textContent='';
 try{
  const data=await ensureActiveJournalData();
  trades=Array.isArray(data.trades)?data.trades:(data.trades=[]);

  const existing=trades.find(t=>t.id===$('tradeId').value);
  const id=$('tradeId').value||crypto.randomUUID();
  const obj={
   id,
   images:[...editImages],
   createdAt:existing?.createdAt||Date.now(),
   updatedAt:Date.now()
  };

  ['instrument','date','entryTime','entryPrice','exitTime','exitPrice','result','points','pnl','contracts','strategy','planFollowed','comment']
   .forEach(k=>obj[k]=$(k)?.value??'');

  const plan={
   date:obj.date||new Date().toISOString().slice(0,10),
   instrument:$('tradePlanInstrument')?.value?.trim()||'',
   maxTrades:$('tradePlanMaxTrades')?.value||'',
   lossLimit:$('tradePlanLossLimit')?.value||'',
   profitTarget:$('tradePlanProfitTarget')?.value||'',
   fromTime:$('tradePlanFromTime')?.value||'',
   toTime:$('tradePlanToTime')?.value||'',
   setup:$('tradePlanSetup')?.value?.trim()||'',
   psychology:$('tradePlanPsychology')?.value?.trim()||'',
   note:$('tradePlanNote')?.value?.trim()||''
  };
  obj.dailyPlan=Object.entries(plan).some(([k,v])=>k!=='date'&&String(v||'').trim())?plan:null;

  obj.points=obj.points===''?0:Math.abs(Number(obj.points)||0);
  obj.pnl=obj.pnl===''?0:Math.abs(Number(obj.pnl)||0);
  obj.contracts=obj.contracts===''?0:Math.abs(Number(obj.contracts)||0);

  const idx=trades.findIndex(t=>t.id===id);
  if(idx>=0)trades[idx]=obj;else trades.push(obj);
  data.trades=trades;

  const result=await window.desktopAPI.writeJournal(activeJournalId,data);
  if(!result?.ok)throw new Error(result?.error||'Data deníku nelze uložit.');

  db={data,close(){}};
  $('tradeModal').classList.remove('open');
  await load();
  showToast(existing?'Obchod byl upraven.':'Obchod byl uložen.');
 }catch(err){
  a.textContent='Obchod se nepodařilo uložit: '+(err?.message||err);
  a.classList.add('show');
 }
});


let pendingMoveTrade=null;
window.openMoveTrade=async(id,sourceJournalId)=>{
 const source=journalProfiles.find(j=>j.id===sourceJournalId);
 const sourceResult=await window.desktopAPI.readJournal(sourceJournalId);
 const trade=(sourceResult?.data?.trades||[]).find(t=>t.id===id);
 if(!trade){alert('Obchod se nepodařilo najít.');return}
 const targets=journalProfiles.filter(j=>j.id!==sourceJournalId);
 if(!targets.length){alert('Nejdříve vytvoř další deník, do kterého lze obchod přesunout.');return}
 pendingMoveTrade={id,sourceJournalId};
 $('moveTradeInfo').textContent=`${trade.instrument||'Bez instrumentu'} · ${trade.date||'bez data'} · z deníku „${source?.name||'Neznámý deník'}“`;
 $('moveTradeTargetJournal').innerHTML=targets.map(j=>`<option value="${esc(j.id)}">${esc(j.name)}</option>`).join('');
 $('moveTradeError').textContent='';$('moveTradeError').classList.remove('show');
 $('moveTradeModal').classList.add('open');
};
function closeMoveTradeModal(){pendingMoveTrade=null;$('moveTradeModal').classList.remove('open')}
$('closeMoveTradeModal').onclick=closeMoveTradeModal;
$('cancelMoveTrade').onclick=closeMoveTradeModal;
$('moveTradeModal').onclick=e=>{if(e.target===$('moveTradeModal'))closeMoveTradeModal()};
$('confirmMoveTrade').onclick=async()=>{
 if(!pendingMoveTrade)return;
 const targetJournalId=$('moveTradeTargetJournal').value;
 const err=$('moveTradeError');
 try{
  const sourceResult=await window.desktopAPI.readJournal(pendingMoveTrade.sourceJournalId);
  const targetResult=await window.desktopAPI.readJournal(targetJournalId);
  if(!sourceResult?.ok)throw new Error(sourceResult?.error||'Zdrojový deník nelze načíst.');
  if(!targetResult?.ok)throw new Error(targetResult?.error||'Cílový deník nelze načíst.');
  const sourceData=sourceResult.data||{trades:[],settings:[]};
  const targetData=targetResult.data||{trades:[],settings:[]};
  sourceData.trades=Array.isArray(sourceData.trades)?sourceData.trades:[];
  targetData.trades=Array.isArray(targetData.trades)?targetData.trades:[];
  const index=sourceData.trades.findIndex(t=>t.id===pendingMoveTrade.id);
  if(index<0)throw new Error('Obchod už ve zdrojovém deníku není.');
  const [trade]=sourceData.trades.splice(index,1);
  if(targetData.trades.some(t=>t.id===trade.id))trade.id=crypto.randomUUID();
  targetData.trades.push(trade);
  const writeTarget=await window.desktopAPI.writeJournal(targetJournalId,targetData);
  if(!writeTarget?.ok)throw new Error(writeTarget?.error||'Obchod nelze uložit do cílového deníku.');
  const writeSource=await window.desktopAPI.writeJournal(pendingMoveTrade.sourceJournalId,sourceData);
  if(!writeSource?.ok){targetData.trades=targetData.trades.filter(t=>t.id!==trade.id);await window.desktopAPI.writeJournal(targetJournalId,targetData);throw new Error(writeSource?.error||'Obchod nelze odstranit ze zdrojového deníku.');}
  const targetName=journalProfiles.find(j=>j.id===targetJournalId)?.name||'cílového deníku';
  const movedFrom=pendingMoveTrade.sourceJournalId;
  closeMoveTradeModal();
  if(movedFrom===activeJournalId)await load();
  await initAccountOverview();await initReports();await initInstrumentPortfolioSection();
  showToast(`Obchod byl přesunut do deníku „${targetName}“.`);
 }catch(e){err.textContent='Přesun se nezdařil: '+(e?.message||e);err.classList.add('show')}
};

document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{
 document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');
 document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
 const target=$(b.dataset.section);if(target)target.classList.add('active');
 $('pageTitle').textContent=b.textContent.replace(/^[^\s]+\s/,'');
 const isHome=b.dataset.section==='home';
 document.querySelector('.topbar').style.display=isHome?'none':'flex';
 $('addTradeBtn').style.display=(b.dataset.section==='journal'||b.dataset.section==='calendar')?'inline-block':'none';
 if(b.dataset.section==='accountOverview')setTimeout(initAccountOverview,60); if(b.dataset.section==='instrumentPortfolio')setTimeout(initInstrumentPortfolioSection,60);
 if(b.dataset.section==='reports')setTimeout(initReports,60);
});
$('refreshInstrumentPortfolio').onclick=drawInstrumentPortfolio;
$('addTradeBtn').onclick=()=>openModal();$('closeModal').onclick=()=>$('tradeModal').classList.remove('open');
$('tradeModal').onclick=e=>{if(e.target===$('tradeModal'))$('tradeModal').classList.remove('open')};
['search','filterResult','filterDate'].forEach(id=>$(id).addEventListener('input',renderTrades));
$('prevMonth').onclick=()=>{calendarDate=new Date(calendarDate.getFullYear(),calendarDate.getMonth()-1,1);renderCalendar()};
$('nextMonth').onclick=()=>{calendarDate=new Date(calendarDate.getFullYear(),calendarDate.getMonth()+1,1);renderCalendar()};
$('saveSettings').onclick=async()=>{settings={startingBalance:Number($('startingBalance').value)||0,currency:'USD',usdCzkRate:Number($('usdCzkRate').value)||23,dailyLossLimit:Number($('dailyLossLimit').value)||0,dailyPointLimit:Number($('dailyPointLimit').value)||0};await put('settings',{key:'main',value:settings});renderAll();alert('Nastavení uloženo.')};
$('exportCsv').onclick=()=>{
 const h=['Instrument','Datum','Čas vstupu','Cena vstupu','Čas výstupu','Cena výstupu','Výsledek','Body','P/L','Kontrakty','Strategie','Dodržen plán','Komentář'];
 const rows=trades.map(t=>[t.instrument,t.date,t.entryTime,t.entryPrice,t.exitTime,t.exitPrice,t.result,t.result==='target'?t.points:-t.points,t.result==='target'?t.pnl:-t.pnl,t.contracts,t.strategy,t.planFollowed,t.comment]);
 const csv=[h,...rows].map(r=>r.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(';')).join('\n');download(new Blob(['\ufeff'+csv],{type:'text/csv'}),'futures-denik.csv')
};
$('printPdf').onclick=()=>window.print();
$('exportJson').onclick=()=>download(new Blob([JSON.stringify({settings,trades},null,2)],{type:'application/json'}),'futures-journal-zaloha.json');
$('importJson').onchange=async e=>{const file=e.target.files?.[0];if(!file)return;try{const data=JSON.parse(await file.text());if(!Array.isArray(data.trades))throw new Error('Chybí seznam obchodů.');if(!confirm('Nahrání zálohy přepíše data aktuálního deníku. Pokračovat?'))return;await clearStore('trades');for(const t of data.trades)await put('trades',t);if(data.settings)await put('settings',{key:'main',value:data.settings});await load();showToast('Záloha aktuálního deníku byla obnovena.')}catch(err){alert('Soubor zálohy není platný: '+err.message)}finally{e.target.value=''}};
$('clearAll').onclick=async()=>{if(confirm('Tato akce smaže všechny obchody a nastavení pouze v aktuálním deníku. Pokračovat?')){await clearStore('trades');await clearStore('settings');location.reload()}};
function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}

$('factoryReset').onclick=async()=>{
 const first=confirm('KOMPLETNÍ RESET smaže všechny deníky, všechny obchody, obrázky a nastavení. Pokračovat?');
 if(!first)return;
 const typed=prompt('Pro potvrzení napiš přesně: SMAZAT VŠE');
 if(typed!=='SMAZAT VŠE'){alert('Reset byl zrušen. Potvrzovací text nebyl správný.');return}
 try{
  if(window.desktopAPI){
   const result=await window.desktopAPI.factoryReset();
   if(!result?.ok)throw new Error(result?.error||'Reset se nepodařil.');
  }else{
   throw new Error('Kompletní reset je dostupný pouze v desktopové aplikaci.');
  }
  localStorage.removeItem(JOURNAL_LIST_KEY);
  localStorage.removeItem(ACTIVE_JOURNAL_KEY);
  localStorage.removeItem(PASSWORD_KEY);
  alert('Aplikace byla kompletně vymazána a vrátí se do čistého stavu.');
  location.reload();
 }catch(err){
  alert('Kompletní reset se nepodařilo dokončit: '+err.message);
 }
};

window.addEventListener('resize',()=>{if($('dashboard').classList.contains('active'))renderDashboard()});

function saveJournalProfiles(){
 localStorage.setItem(JOURNAL_LIST_KEY,JSON.stringify(journalProfiles));
 localStorage.setItem(ACTIVE_JOURNAL_KEY,activeJournalId);
}
function renderJournalSelector(){
 const select=$('journalSelect');
 if(!journalProfiles.length){
  select.innerHTML='<option value="">Nejprve vytvořte deník</option>';
  select.value='';
  select.disabled=true;
  $('renameJournalBtn').disabled=true;
  $('deleteJournalBtn').disabled=true;
  return;
 }
 select.disabled=false;
 $('renameJournalBtn').disabled=false;
 $('deleteJournalBtn').disabled=false;
 select.innerHTML=journalProfiles.map(j=>`<option value="${esc(j.id)}">${esc(j.name)}</option>`).join('');
 select.value=activeJournalId;
}
async function switchJournal(id){
 if(id===activeJournalId)return;
 if(db)db.close();
 activeJournalId=id;saveJournalProfiles();
 location.reload();
}
$('journalSelect').onchange=e=>switchJournal(e.target.value);
let journalNameMode='new';
function openJournalNameModal(mode){
 journalNameMode=mode;
 const current=journalProfiles.find(x=>x.id===activeJournalId);
 $('journalNameModalTitle').textContent=mode==='new'?'Nový deník':'Přejmenovat deník';
 $('journalNameInput').value=mode==='rename'&&current?current.name:'';
 $('journalNameError').textContent='';
 $('journalNameError').style.display='none';
 $('journalNameModal').classList.add('open');
 setTimeout(()=>{$('journalNameInput').focus();$('journalNameInput').select()},30);
}
function closeJournalNameModal(){ $('journalNameModal').classList.remove('open'); }
async function saveJournalNameFromModal(){
 const clean=$('journalNameInput').value.trim();
 const err=$('journalNameError');
 if(!clean){err.textContent='Zadej název deníku.';err.style.display='block';return}
 if(journalNameMode==='new'){
  if(journalProfiles.some(j=>j.name.toLowerCase()===clean.toLowerCase())){err.textContent='Deník s tímto názvem už existuje.';err.style.display='block';return}
  const id='journal_'+Date.now()+'_'+Math.random().toString(36).slice(2,8);
  journalProfiles.push({id,name:clean});activeJournalId=id;saveJournalProfiles();closeJournalNameModal();location.reload();
 }else{
  const j=journalProfiles.find(x=>x.id===activeJournalId);if(!j)return;
  if(journalProfiles.some(x=>x.id!==j.id&&x.name.toLowerCase()===clean.toLowerCase())){err.textContent='Deník s tímto názvem už existuje.';err.style.display='block';return}
  j.name=clean;saveJournalProfiles();renderJournalSelector();initReports();closeJournalNameModal();showToast('Deník byl přejmenován.');
 }
}
$('newJournalBtn').onclick=()=>openJournalNameModal('new');
$('renameJournalBtn').onclick=()=>openJournalNameModal('rename');
$('closeJournalNameModal').onclick=closeJournalNameModal;
$('cancelJournalName').onclick=closeJournalNameModal;
$('saveJournalName').onclick=saveJournalNameFromModal;
$('journalNameInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();saveJournalNameFromModal()}if(e.key==='Escape')closeJournalNameModal()});
$('journalNameModal').addEventListener('click',e=>{if(e.target===$('journalNameModal'))closeJournalNameModal()});
$('deleteJournalBtn').addEventListener('click',async()=>{
 if(journalProfiles.length<=1){alert('Poslední deník nelze smazat.');return}
 const j=journalProfiles.find(x=>x.id===activeJournalId);if(!j)return;
 if(!confirm(`Opravdu smazat deník „${j.name}“ včetně všech jeho dat?`))return;
 if(db)db.close();
 const deleted=await window.desktopAPI.deleteJournal(activeJournalId);
 if(!deleted?.ok){alert('Deník se nepodařilo smazat: '+(deleted?.error||'Neznámá chyba'));return}
 journalProfiles=journalProfiles.filter(x=>x.id!==activeJournalId);activeJournalId=journalProfiles[0].id;saveJournalProfiles();location.reload();
});
renderJournalSelector();


function showToast(message){
 const el=$('statusToast');el.textContent=message;el.classList.add('show');clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>el.classList.remove('show'),2600);
}
$('portfolioToggle')?.addEventListener('click',()=>{
 const body=$('portfolioBody'),collapsed=body.classList.toggle('collapsed');$('portfolioArrow').textContent=collapsed?'▶':'▼';localStorage.setItem('FuturesJournal_portfolioCollapsed',collapsed?'1':'0');
});
if(localStorage.getItem('FuturesJournal_portfolioCollapsed')==='1'){$('portfolioBody').classList.add('collapsed');$('portfolioArrow').textContent='▶'}
async function refreshPortfolio(){
 try{
  const all=await collectReportRows();const wins=all.filter(t=>t.result==='target'),losses=all.filter(t=>t.result==='stoploss');
  const pnl=all.reduce((a,t)=>a+reportSigned(t),0),gw=wins.reduce((a,t)=>a+Number(t.pnl||0),0),gl=losses.reduce((a,t)=>a+Number(t.pnl||0),0);
  $('portfolioPnl').innerHTML=dualMoney(pnl,true);$('portfolioPnl').className=pnl>=0?'pos':'neg';
  $('portfolioTrades').textContent=all.length;$('portfolioWinrate').textContent=all.length?(wins.length/all.length*100).toFixed(1)+' %':'0 %';$('portfolioPf').textContent=gl?(gw/gl).toFixed(2):(gw?'∞':'0');
 }catch(err){console.error('Portfolio:',err)}
}
async function collectAllJournalsBackup(){
 const journals=[];
 for(const profile of journalProfiles){
  const result=await window.desktopAPI.readJournal(profile.id);
  if(!result?.ok)throw new Error(result?.error||`Deník ${profile.name} nelze načíst.`);
  journals.push({profile,trades:result.data?.trades||[],settings:result.data?.settings||[]});
 }
 return {app:'Futures Journal',version:2,exportedAt:new Date().toISOString(),activeJournalId,profiles:journalProfiles,journals};
}
async function restoreAllJournalsBackup(data){
 if(!data||!Array.isArray(data.profiles)||!Array.isArray(data.journals))throw new Error('Neplatná záloha.');
 for(const j of data.journals){
  const result=await window.desktopAPI.writeJournal(j.profile.id,{trades:j.trades||[],settings:j.settings||[]});
  if(!result?.ok)throw new Error(result?.error||`Deník ${j.profile.name} nelze obnovit.`);
 }
 journalProfiles=data.profiles;
 activeJournalId=data.activeJournalId||data.profiles[0].id;
 saveJournalProfiles();
 location.reload();
}

async function refreshBackupPathInfo(){
 if(!window.desktopAPI)return;
 const p=await window.desktopAPI.getBackupPath();
 $('backupPathInfo').textContent=p?`Aktuální záloha: ${p}`:'Umístění zálohy zatím není zvoleno.';
}
if(window.desktopAPI){
 $('updateBackup').onclick=async()=>{
  try{
   const data=await collectAllJournalsBackup();
   const result=await window.desktopAPI.saveBackup(JSON.stringify(data));
   if(result?.ok){
    $('backupPathInfo').textContent=`Aktuální záloha: ${result.path}`;
    alert('Kompletní záloha byla aktualizována.');
   }
  }catch(err){alert('Zálohu se nepodařilo vytvořit: '+err.message)}
 };
 $('restoreBackup').onclick=async()=>{
  try{
   const result=await window.desktopAPI.loadBackup();
   if(!result?.ok)return;
   if(!confirm('Obnova přepíše současná data všech deníků. Pokračovat?'))return;
   await restoreAllJournalsBackup(JSON.parse(result.content));
  }catch(err){alert('Zálohu se nepodařilo obnovit: '+err.message)}
 };
 refreshBackupPathInfo();
}else{
 $('updateBackup').onclick=()=>alert('Tato funkce je dostupná v desktopové aplikaci.');
 $('restoreBackup').onclick=()=>alert('Tato funkce je dostupná v desktopové aplikaci.');
}


async function readJournalTrades(profile){
 const result=await window.desktopAPI.readJournal(profile.id);
 if(!result?.ok)throw new Error(result?.error||`Deník ${profile.name} nelze načíst.`);
 return (result.data?.trades||[]).map(t=>({...t,journalId:profile.id,journalName:profile.name}));
}

async function collectReportRows(){
 const all=[];
 for(const p of journalProfiles)all.push(...await readJournalTrades(p));
 return all;
}
function reportSigned(t){const v=Number(t.pnl||0);return t.result==='target'?v:-v}
function groupSummary(rows,key,nameMap={}){
 const map={};
 rows.forEach(t=>{
  const k=t[key]||'Nezadáno';
  if(!map[k])map[k]={name:nameMap[k]||k,count:0,wins:0,losses:0,pnl:0};
  map[k].count++;if(t.result==='target')map[k].wins++;else if(t.result==='stoploss')map[k].losses++;
  map[k].pnl+=reportSigned(t);
 });
 return Object.values(map).sort((a,b)=>b.pnl-a.pnl);
}
function drawReportChart(rows){
 const {x,w,h}=setupCanvas($('reportChart')),pad={l:65,r:20,t:25,b:45};
 const daily={};rows.forEach(t=>daily[t.date||'Bez data']=(daily[t.date||'Bez data']||0)+reportSigned(t));
 const labels=Object.keys(daily).sort(), vals=[];let running=0;labels.forEach(d=>{running+=daily[d];vals.push(running)});
 x.clearRect(0,0,w,h);x.strokeStyle='#273452';x.fillStyle='#98a6c7';x.font='11px sans-serif';
 if(!vals.length){x.fillText('Pro vybraný filtr nejsou data.',30,h/2);return}
 let min=Math.min(0,...vals),max=Math.max(0,...vals);if(min===max){min-=1;max+=1}
 for(let i=0;i<5;i++){const y=pad.t+(h-pad.t-pad.b)*i/4;x.beginPath();x.moveTo(pad.l,y);x.lineTo(w-pad.r,y);x.stroke();x.fillText(Math.round(max-(max-min)*i/4),6,y+4)}
 const px=i=>pad.l+(w-pad.l-pad.r)*(vals.length===1?.5:i/(vals.length-1));
 const py=v=>pad.t+(max-v)/(max-min)*(h-pad.t-pad.b);
 x.beginPath();vals.forEach((v,i)=>i?x.lineTo(px(i),py(v)):x.moveTo(px(i),py(v)));x.strokeStyle='#5ba7ff';x.lineWidth=3;x.stroke();
 x.fillStyle='#5ba7ff';vals.forEach((v,i)=>{x.beginPath();x.arc(px(i),py(v),3,0,Math.PI*2);x.fill()});
}
async function initReports(){
 const all=await collectReportRows();
 const instruments=[...new Set(all.map(t=>t.instrument).filter(Boolean))].sort();
 $('reportJournal').innerHTML='<option value="">Všechny deníky</option>'+journalProfiles.map(j=>`<option value="${esc(j.id)}">${esc(j.name)}</option>`).join('');
 $('reportInstrument').innerHTML='<option value="">Všechny instrumenty</option>'+instruments.map(i=>`<option>${esc(i)}</option>`).join('');
 generateReportView(all);
}
function generateReportView(allRows=null){
 const run=async()=>{
  const all=allRows||await collectReportRows();
  const f=$('reportFrom').value,to=$('reportTo').value,j=$('reportJournal').value,i=$('reportInstrument').value;
  reportRows=all.filter(t=>(!f||t.date>=f)&&(!to||t.date<=to)&&(!j||t.journalId===j)&&(!i||t.instrument===i));
  const wins=reportRows.filter(t=>t.result==='target'),losses=reportRows.filter(t=>t.result==='stoploss');
  const pnl=reportRows.reduce((a,t)=>a+reportSigned(t),0),gw=wins.reduce((a,t)=>a+Number(t.pnl||0),0),gl=losses.reduce((a,t)=>a+Number(t.pnl||0),0);
  $('reportCount').textContent=reportRows.length;
  $('reportPnl').innerHTML=dualMoney(pnl,true);$('reportPnl').className='value '+(pnl>=0?'pos':'neg');
  $('reportWinrate').textContent=reportRows.length?(wins.length/reportRows.length*100).toFixed(1)+' %':'0 %';
  $('reportPf').textContent=gl?(gw/gl).toFixed(2):(gw?'∞':'0');
  $('reportAvg').innerHTML=dualMoney(reportRows.length?pnl/reportRows.length:0);
  const inst=groupSummary(reportRows,'instrument'),jr=groupSummary(reportRows,'journalId',Object.fromEntries(journalProfiles.map(x=>[x.id,x.name])));
  $('reportInstrumentRows').innerHTML=inst.map(s=>`<tr><td>${esc(s.name)}</td><td>${s.count}</td><td>${s.wins}</td><td>${s.losses}</td><td>${s.count?(s.wins/s.count*100).toFixed(1):0} %</td><td class="${s.pnl>=0?'pos':'neg'}">${dualMoney(s.pnl,true)}</td></tr>`).join('');
  $('reportJournalRows').innerHTML=jr.map(s=>`<tr><td>${esc(s.name)}</td><td>${s.count}</td><td>${s.wins}</td><td>${s.losses}</td><td>${s.count?(s.wins/s.count*100).toFixed(1):0} %</td><td class="${s.pnl>=0?'pos':'neg'}">${dualMoney(s.pnl,true)}</td></tr>`).join('');
  $('reportTradeList').innerHTML=reportRows.length?reportRows.sort((a,b)=>(b.date+b.entryTime).localeCompare(a.date+a.entryTime)).map(t=>`<div class="card"><div class="title">${esc(t.instrument||'Bez instrumentu')} · ${esc(t.journalName)}</div>${tradeHTML(t)}</div>`).join(''):'<div class="card sub">Pro vybraný filtr nejsou žádné obchody.</div>';
  drawReportChart(reportRows);
 };
 run();
}
$('generateReport').onclick=()=>generateReportView();
$('reportPrint').onclick=()=>window.print();
$('reportCsv').onclick=()=>{
 const h=['Deník','Instrument','Datum','Čas vstupu','Cena vstupu','Čas výstupu','Cena výstupu','Výsledek','Body','P/L','Komentář'];
 const rows=reportRows.map(t=>[t.journalName,t.instrument,t.date,t.entryTime,t.entryPrice,t.exitTime,t.exitPrice,t.result,reportSigned({...t,pnl:t.points}),reportSigned(t),t.comment]);
 const csv=[h,...rows].map(r=>r.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(';')).join('\n');
 download(new Blob(['\ufeff'+csv],{type:'text/csv'}),'futures-report.csv');
};
setTimeout(()=>{initReports();refreshPortfolio()},300);

window.addEventListener('error',e=>console.error('Chyba aplikace:',e.error||e.message));
window.addEventListener('unhandledrejection',e=>console.error('Nezachycená chyba:',e.reason));

let captureSnapshot=null;

async function refreshCaptureStatus(){
 if(!window.desktopAPI?.captureStatus)return;
 const r=await window.desktopAPI.captureStatus();
 if(!r?.ok)return;
 captureSnapshot=r;
 $('captureStatusText').value=r.running?`Běží na portu ${r.port}`:'Neběží';
 $('capturePendingCount').value=r.pending;
 $('captureEndpoint').value=r.endpoint;
 $('captureApiKey').value=r.apiKey;
 $('captureScreenshotMode').value=r.screenshotMode||'primary';
 $('captureAutoImportSelect').value=r.autoImport?'ano':'ne';
 $('relayUrl').value=r.relayUrl||'';
 $('relayToken').value=r.relayToken||'';
 $('relayEnabled').value=r.relayEnabled?'ano':'ne';
 renderCaptureMappings(r.accounts||[],r.accountMappings||{},r.hiddenAccounts||[]);
 renderOpenPositions(r.openPositions||[]);
}
function renderOpenPositions(rows){
 const target=$('captureOpenPositions');
 if(!target)return;
 const fmtPrice=v=>Number.isFinite(Number(v))?Number(v).toLocaleString('cs-CZ',{maximumFractionDigits:8}):'—';
 const fmtTime=v=>{if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?esc(v):d.toLocaleString('cs-CZ');};
 target.innerHTML=rows.length?rows.map(p=>{
  const entry=Number(p.avgPrice||0);
  const current=Number(p.currentPrice??p.lastPrice??entry);
  const direction=p.side==='short'?-1:1;
  const qty=Math.abs(Number(p.qty||0));
  const pointValue=Number(p.pointValue||1);
  const rate=Number(p.rate||1);
  const pnl=(current-entry)*direction*qty*pointValue*rate;
  return `<tr>
   <td><b>${esc(p.instrumentFull||p.instrument||'—')}</b><div class="sub">${esc(p.account||'')}</div></td>
   <td class="${p.side==='long'?'pos':p.side==='short'?'neg':''}"><b>${p.side==='long'?'LONG':p.side==='short'?'SHORT':'—'}</b></td>
   <td>${fmtTime(p.openedAt)}</td>
   <td>${fmtPrice(entry)}</td>
   <td>${fmtPrice(current)}</td>
   <td class="${pnl>0?'pos':pnl<0?'neg':''}">${pnl>=0?'+':''}${pnl.toLocaleString('cs-CZ',{maximumFractionDigits:2})}</td>
  </tr>`;
 }).join(''):'<tr><td colspan="6" class="sub">Žádné otevřené pozice.</td></tr>';
}
function renderCaptureMappings(accounts,mappings,hiddenAccounts=[]){
 const hidden=new Set(hiddenAccounts);
 const visible=accounts.filter(account=>!hidden.has(account));
 $('captureMappingRows').innerHTML=visible.length?visible.map(account=>`<div class="mapping-row">
  <div><b>${esc(account)}</b></div>
  <select class="capture-mapping" data-account="${esc(account)}">
   <option value="">Aktivní karta při importu</option>
   ${journalProfiles.map(j=>`<option value="${esc(j.id)}" ${mappings[account]===j.id?'selected':''}>${esc(j.name)}</option>`).join('')}
  </select>
  <button class="btn capture-hide-account" data-account="${esc(account)}" title="Skrýt účet ze seznamu" style="padding:5px 9px;font-size:12px;min-width:auto">Skrýt</button>
 </div>`).join(''):'<p class="sub">V seznamu nejsou žádné zobrazené účty.</p>';
 const box=$('captureHiddenAccountsBox');
 box.innerHTML=hiddenAccounts.length?`<details><summary style="cursor:pointer;font-weight:800;letter-spacing:.03em">SKRYTÉ ÚČTY (${hiddenAccounts.length})</summary><div style="margin-top:10px">${hiddenAccounts.map(account=>`<div class="mapping-row"><div><b>${esc(account)}</b></div><div style="display:flex;gap:6px;justify-content:flex-end"><button class="btn capture-restore-account" data-account="${esc(account)}" style="padding:5px 9px;font-size:12px">Přidat zpět</button><button class="btn danger capture-delete-account" data-account="${esc(account)}" style="padding:5px 9px;font-size:12px">Odstranit</button></div></div>`).join('')}</div></details>`:'';
 document.querySelectorAll('.capture-hide-account').forEach(btn=>btn.onclick=async()=>{
  const next=[...new Set([...(captureSnapshot?.hiddenAccounts||[]),btn.dataset.account])];
  await window.desktopAPI.captureSetHiddenAccounts(next);await refreshCaptureStatus();
 });
 document.querySelectorAll('.capture-restore-account').forEach(btn=>btn.onclick=async()=>{
  const next=(captureSnapshot?.hiddenAccounts||[]).filter(a=>a!==btn.dataset.account);
  await window.desktopAPI.captureSetHiddenAccounts(next);await refreshCaptureStatus();
 });
 document.querySelectorAll('.capture-delete-account').forEach(btn=>btn.onclick=async()=>{
  const account=btn.dataset.account;
  if(!confirm(`Účet ${account} bude trvale odstraněn ze seznamu účtů. Pokračovat?`))return;
  await window.desktopAPI.captureDeleteAccount(account);await refreshCaptureStatus();
 });
}
async function capturedImages(e){
 const paths=Array.isArray(e.screenshotPaths)?e.screenshotPaths:[];
 const images=[];
 for(const p of paths.slice(0,3)){
  const r=await window.desktopAPI.captureReadScreenshot(p);
  if(r?.ok&&r.dataUrl)images.push(r.dataUrl);
 }
 return images;
}
function mapCapturedTrade(e,images=[]){
 const entry=new Date(e.entryTime||e.receivedAt||Date.now());
 const exit=new Date(e.exitTime||e.receivedAt||Date.now());
 const pnl=Number(e.pnl||0);
 return {
  id:crypto.randomUUID(),
  instrument:e.instrument||e.instrumentFull||'',
  date:exit.toISOString().slice(0,10),
  entryTime:entry.toTimeString().slice(0,5),
  entryPrice:Number(e.entryPrice||0),
  exitTime:exit.toTimeString().slice(0,5),
  exitPrice:Number(e.exitPrice||0),
  result:e.result||(pnl>=0?'target':'stoploss'),
  points:Math.abs(Number(e.points||0)),
  pnl:Math.abs(pnl),
  contracts:Number(e.quantity||e.contracts||1),
  strategy:e.strategy||'NinjaTrader automatický import',
  planFollowed:'ano',
  comment:e.comment||`Automaticky importováno ze zdroje ${e.source||'integrace'}.`,
  images,
  createdAt:Date.now(),
  sourceEventId:e.id,
  externalAccount:e.account||'',
  commission:Number(e.commission||0),
  grossPnl:Number(e.grossPnl||0),
  side:e.side||''
 };
}
async function appendTradeToJournal(journalId,trade){
 const r=await window.desktopAPI.readJournal(journalId);
 if(!r?.ok)throw new Error(r?.error||'Deník nelze načíst.');
 const data=r.data||{trades:[],settings:[]};
 data.trades=Array.isArray(data.trades)?data.trades:[];
 if(data.trades.some(t=>t.sourceEventId===trade.sourceEventId))return false;
 data.trades.push(trade);
 const w=await window.desktopAPI.writeJournal(journalId,data);
 if(!w?.ok)throw new Error(w?.error||'Deník nelze uložit.');
 return true;
}
async function importCapturedTrades(silent=false){
 const r=await window.desktopAPI.captureEvents(false);
 const pending=(r?.events||[]).filter(e=>e.type==='trade_closed');
 if(!pending.length){if(!silent)alert('Nejsou připravené žádné uzavřené obchody.');return 0}
 const mappings=captureSnapshot?.accountMappings||{};
 const importedIds=[];
 let count=0;
 for(const e of pending){
  const journalId=mappings[e.account]||activeJournalId;
  const images=await capturedImages(e);
  const added=await appendTradeToJournal(journalId,mapCapturedTrade(e,images));
  if(added)count++;
  importedIds.push(e.id);
 }
 await window.desktopAPI.captureMarkImported(importedIds);
 if(mappings&&Object.values(mappings).includes(activeJournalId)||!Object.keys(mappings).length){
  const current=await window.desktopAPI.readJournal(activeJournalId);
  if(current?.ok){db.data=current.data;trades=db.data.trades||[];renderAll()}
 }
 await refreshCaptureStatus();
 if(!silent)alert(`Importováno obchodů: ${count}`);
 return count;
}
$('clearInvalidPositions').onclick=async()=>{
 if(!confirm('Vymazat celý seznam otevřených pozic v deníku? Uzavřené obchody se nesmažou.'))return;
 await window.desktopAPI.captureClearPositions();
 await refreshCaptureStatus();
};
$('captureRefresh').onclick=refreshCaptureStatus;
$('captureTestSequence').onclick=async()=>{await window.desktopAPI.captureTestExecutionSequence();await refreshCaptureStatus()};
$('captureImport').onclick=()=>importCapturedTrades(false);
$('captureInstallNinja').onclick=async()=>{
 const r=await window.desktopAPI.captureInstallNinjaConnector();
 if(r?.ok)alert('Hotovo. Konektor byl automaticky vložen do NinjaTraderu. Teď spusť NinjaTrader, otevři NinjaScript Editor a stiskni F5 pro kompilaci.');
 else alert('Automatická instalace se nepodařila: '+(r?.error||'neznámá chyba'));
};
$('capturePrepareTradingView').onclick=async()=>{
 const r=await window.desktopAPI.capturePrepareTradingViewPine();
 if(r?.ok)alert('Pine Script je zkopírovaný ve schránce a TradingView se otevřel. V Pine Editoru stiskni Ctrl+V a Přidat do grafu.');
 else alert('Příprava Pine Scriptu se nepodařila: '+(r?.error||'neznámá chyba'));
};
$('capturePrepareWorker').onclick=async()=>{
 const r=await window.desktopAPI.capturePrepareTradingViewWorker();
 if(r?.ok)alert('Kód webhooku je zkopírovaný ve schránce a Cloudflare se otevřel. Vytvoř Worker, smaž ukázkový kód, stiskni Ctrl+V a Deploy.');
 else alert('Příprava webhooku se nepodařila: '+(r?.error||'neznámá chyba'));
};
$('captureExportConnector').onclick=async()=>{
 const r=await window.desktopAPI.captureExportNinjaConnector();
 if(r?.ok)alert('Konektor byl uložen. V NinjaTraderu ho importuj přes Tools → Import → NinjaScript Add-On.');
 else if(!r?.canceled)alert('Konektor se nepodařilo uložit: '+(r?.error||'neznámá chyba'));
};
$('captureExportTradingView').onclick=async()=>{
 const r=await window.desktopAPI.captureExportTradingViewConnector();
 if(r?.ok)alert('TradingView Pine Script byl uložen. Otevři ho, zkopíruj celý kód do Pine Editoru a klikni na Přidat do grafu.');
 else if(!r?.canceled)alert('TradingView Pine Script se nepodařilo uložit: '+(r?.error||'neznámá chyba'));
};
$('captureExportTradingViewWorker').onclick=async()=>{
 const r=await window.desktopAPI.captureExportTradingViewWorker();
 if(r?.ok)alert('Soubor webhook relay byl uložen. Použije se při nastavení veřejného webhooku pro TradingView.');
 else if(!r?.canceled)alert('Webhook relay se nepodařilo uložit: '+(r?.error||'neznámá chyba'));
};
$('captureOpenConnectors').onclick=async()=>{const r=await window.desktopAPI.captureOpenConnectorFolder();if(!r?.ok)alert('Složku nelze otevřít: '+(r?.error||''))};
$('captureNewKey').onclick=async()=>{
 if(!confirm('Starý NinjaTrader konektor přestane fungovat, dokud v něm nezměníš klíč. Pokračovat?'))return;
 await window.desktopAPI.captureRegenerateKey();await refreshCaptureStatus();
};
$('captureClear').onclick=async()=>{if(confirm('Vymazat frontu zachycených událostí?')){await window.desktopAPI.captureClear();await refreshCaptureStatus()}};
$('captureScreenshotMode').onchange=async e=>{await window.desktopAPI.captureSetScreenshotMode(e.target.value);await refreshCaptureStatus()};
$('captureAutoImportSelect').onchange=async e=>{await window.desktopAPI.captureSetAutoImport(e.target.value==='ano');await refreshCaptureStatus()};
$('captureSaveMappings').onclick=async()=>{
 const mappings={...(captureSnapshot?.accountMappings||{})};
 document.querySelectorAll('.capture-mapping').forEach(s=>{if(s.value)mappings[s.dataset.account]=s.value;else delete mappings[s.dataset.account]});
 await window.desktopAPI.captureSetMappings(mappings);
 await refreshCaptureStatus();
 alert('Přiřazení účtů bylo uloženo.');
};
$('saveRelay').onclick=async()=>{
 await window.desktopAPI.captureSetRelay({enabled:$('relayEnabled').value==='ano',url:$('relayUrl').value,token:$('relayToken').value});
 await refreshCaptureStatus();alert('Nastavení TradingView relay bylo uloženo.');
};
$('pollRelay').onclick=async()=>{
 try{const r=await window.desktopAPI.capturePollRelay();await refreshCaptureStatus();alert(`Staženo alertů: ${r?.count||0}`)}
 catch(e){alert('Relay nelze načíst: '+e.message)}
};
window.desktopAPI?.onCaptureEvent?.(async()=>{
 await refreshCaptureStatus();
 const s=await window.desktopAPI.captureStatus();
 if(s?.autoImport&&s.pending)await importCapturedTrades(true);
});
setInterval(async()=>{
 const s=await window.desktopAPI?.captureStatus?.();
 if(s?.autoImport&&s.pending)await importCapturedTrades(true);
},5000);
setTimeout(refreshCaptureStatus,800);


let overviewAllTrades=[];
async function readTradesForOverview(profile){
 const result=await window.desktopAPI.readJournal(profile.id);
 if(!result?.ok)throw new Error(result?.error||`Deník ${profile.name} nelze načíst.`);
 const rows=Array.isArray(result.data?.trades)?result.data.trades:[];
 return rows.map(t=>({...t,journalId:profile.id,journalName:profile.name}));
}
function refreshAccountInstrumentOptions(preferredValue=''){
 const selectedJournal=$('accountJournal').value;
 const source=selectedJournal?overviewAllTrades.filter(t=>t.journalId===selectedJournal):overviewAllTrades;
 const instruments=[...new Set(source.map(t=>String(t.instrument||'').trim()).filter(Boolean))]
  .sort((a,b)=>a.localeCompare(b,'cs',{sensitivity:'base'}));
 $('accountInstrument').innerHTML='<option value="">Všechny instrumenty</option>'+instruments.map(i=>`<option value="${esc(i)}">${esc(i)}</option>`).join('');
 $('accountInstrument').value=instruments.includes(preferredValue)?preferredValue:'';
}
async function initAccountOverview(){
 overviewAllTrades=[];
 for(const p of journalProfiles)overviewAllTrades.push(...await readTradesForOverview(p));
 const oldJ=$('accountJournal').value,oldI=$('accountInstrument').value;
 $('accountJournal').innerHTML='<option value="">Všechny deníky</option>'+journalProfiles.map(p=>`<option value="${esc(p.id)}">${esc(p.name)}</option>`).join('');
 $('accountJournal').value=journalProfiles.some(p=>p.id===oldJ)?oldJ:'';
 refreshAccountInstrumentOptions(oldI);
 syncAccountDateFields();
 applyAccountOverview();
}
function syncAccountDateFields(){
 const mode=$('accountRangeMode').value;
 document.querySelectorAll('.account-day-field').forEach(el=>el.style.display=mode==='day'?'block':'none');
 document.querySelectorAll('.account-interval-field').forEach(el=>el.style.display=mode==='interval'?'block':'none');
}
function filteredOverviewTrades(){
 const mode=$('accountRangeMode').value,day=$('accountDay').value,from=$('accountFrom').value,to=$('accountTo').value;
 const journal=$('accountJournal').value,instrument=$('accountInstrument').value;
 return overviewAllTrades.filter(t=>{
  if(journal&&t.journalId!==journal)return false;
  if(instrument&&t.instrument!==instrument)return false;
  if(mode==='day'&&day&&t.date!==day)return false;
  if(mode==='interval'&&from&&t.date<from)return false;
  if(mode==='interval'&&to&&t.date>to)return false;
  return true;
 });
}
function applyAccountOverview(){
 const rows=filteredOverviewTrades();
 renderDashboard(rows);
 $('accountOverviewTrades').innerHTML=rows.length?rows.slice().sort((a,b)=>(b.date+(b.entryTime||'')).localeCompare(a.date+(a.entryTime||''))).map(tradeHTML).join(''):'<div class="sub">Pro vybraný filtr nejsou žádné obchody.</div>';
}
$('accountRangeMode').onchange=syncAccountDateFields;
$('accountJournal').onchange=()=>{refreshAccountInstrumentOptions();applyAccountOverview()};
$('accountInstrument').onchange=applyAccountOverview;
$('applyAccountFilters').onclick=applyAccountOverview;
$('clearAccountFilters').onclick=()=>{
 $('accountRangeMode').value='all';$('accountDay').value='';$('accountFrom').value='';$('accountTo').value='';$('accountJournal').value='';$('accountInstrument').value='';
 syncAccountDateFields();applyAccountOverview();
};
syncAccountDateFields();

document.querySelector('.topbar').style.display='none';
let journalAppStarted=false;
async function startJournalApplication(){
 if(journalAppStarted)return;
 journalAppStarted=true;
 try{
  await removeLegacyDefaultJournal();
  renderJournalSelector();
  if(!journalProfiles.length){
   openJournalNameModal('new');
   showToast('Vytvořte svůj první deník.');
   return;
  }
  await openDB();
  await load();
 }
 catch(e){journalAppStarted=false;alert('Databázi se nepodařilo otevřít: '+e.message)}
}
window.addEventListener('journal:authenticated',()=>{void startJournalApplication()},{once:true});
</script>
<script src="login.js"></script>
</body>
</html>