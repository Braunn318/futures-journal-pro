{
  "name": "futures-journal-pro",
  "version": "4.4.7",
  "description": "Futures Journal PRO 4.4.7 – cíle sdílející stejnou cenu výstupu (např. TP2 přesunutý na TP1) se teď spojí do jednoho cíle se sečteným počtem kontraktů, místo matoucího zobrazení jako dva samostatné. Detail cíle teď jde vidět i po kliknutí, ne jen po najetí myší.",
  "main": "main.js",
  "author": "Jája S",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "start:debug": "electron . --enable-logging"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "glob": "latest",
    "rimraf": "latest",
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "cz.futuresjournal.pro",
    "productName": "Futures Journal PRO",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "NAVOD_AUTOMATIZACE.txt"
    ],
    "extraResources": [
      {
        "from": "CONNECTORS",
        "to": "CONNECTORS"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/assets/bull_bear_icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Futures Journal PRO",
      "uninstallDisplayName": "Futures Journal PRO",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "artifactName": "Futures-Journal-PRO-Setup-${version}.${ext}",
    "asar": true
  }
}